["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: I have used de shadows to see inside de cavern. I have seen my people--dead, alive, or... both.",
["timestamp"] = 1774329664,
["id"] = "s7_4914",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
