},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Arator yells: Lothraxion, this isn't what the Light demands of us.",
["timestamp"] = 1774223765,
["id"] = "s7_4660",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Arator yells: Think of the lives that will be lost--just trust us.",
["timestamp"] = 1774223768,
["id"] = "s7_4661",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Lothraxion",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Lothraxion yells: You of them all, I thought would understand Arator. ",
["timestamp"] = 1774223772,
["id"] = "s7_4662",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Lothraxion",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Lothraxion yells: A shame that the Void has corrupted you too.",
["timestamp"] = 1774223777,
["id"] = "s7_4663",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Circuit Seer",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Circuit Seer yells: The pylon is showing near critical failure, Chief Corewright!",
["timestamp"] = 1774223783,
["id"] = "s7_4664",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kasreth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Kasreth yells: Hurry up those repairs. If we aren't careful, that will be all of us!",
["timestamp"] = 1774223787,
["id"] = "s7_4665",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kasreth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Kasreth yells: More of you mindless intruders!",
["timestamp"] = 1774223997,
["id"] = "s7_4666",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kasreth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Kasreth yells: But my job isn't done... There's still...",
