r\":1},\"text\":\"Lirath Windrunner says: I'll use these relics to return peace to the spire. Perhaps then my sisters will return to me.\",\"id\":\"s2_3391\",\"timestamp\":1773343341},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:127:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: huge up for me if you dont\",\"id\":\"s2_3392\",\"timestamp\":1773343341},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: There! The restless heart that haunts us! Please, lay it to rest.\",\"id\":\"s2_3393\",\"timestamp\":1773343348},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Shangere-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Shangere-Proudmoore:129:PARTY:|h[|cffff7c0aShangere-Proudmoore|r]|h: soulbound sorry\",\"id\":\"s2_3394\",\"timestamp\":1773343352},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:130:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: all g\",\"id\":\"s2_3395\",\"timestamp\":1773343354},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Restless Heart\"},\"