-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Plexx-Proudmoore|h[|cffc69b6dPlexx-Proudmoore|r]|h has earned the achievement |cffffff00|Hachievement:61508:Player-5-0E5D59BC:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Voidscar Arena]|h|r!\",\"timestamp\":1772757401,\"id\":\"s0_1652\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Human\",\"name\":\"Plexx-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Plexx-Proudmoore|h[|cffc69b6dPlexx-Proudmoore|r]|h has earned the achievement |cffffff00|Hachievement:61510:Player-5-0E5D59BC:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Voidscar Arena]|h|r!\",\"timestamp\":1772757401,\"id\":\"s0_1653\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Human\",\"name\":\"Plexx-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Plexx-Proudmoore|h[|cffc69b6dPlexx-Proudmoore|r]|h has earned the achievement |cffffff00|Hachievement:61509:Player-5-0E5D59BC:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Voidscar Arena]|h|r!\",\"timestamp\":1772757401,\"id\":\"s0_1654\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kalgorg the Unshackled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kalgorg the Unshackled says: Brazen elf! I will return, only so that I might witness your end!\",\"timestamp\":1772757403,\"id\":\"s0_1655\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:264297::::::::87:1473::11:4:13573:13614:13616:6652:2:9:87:28:3321:::::|h[Nightbreaker's Cuffs]|h|r\",\"timestamp\":1772757449,\"id\":\"s0_1656\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lucia Nightbreaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lucia Nightbreaker says: Tell you what, minion. After one hundred years, if you're still unhappy with our arrangement, I'll allow you to renegotiate our terms.\",\"timestamp\":1772757451,\"id\":\"s0_1657\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kalgorg\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Kalgorg whispers: You will both die screaming in agony.\",\"timestamp\":1772757458,\"id\":\"s0_1658\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:243605::::::::87:1473::::1:38:13:::::|h[Dawn Crystal |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r\",\"timestamp\":1772757459,\"id\":\"s0_1659\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lucia Nightbreaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lucia Nightbreaker says: Threatening my new associate? Make it two hundred years.\",\"timestamp\":1772757461,\"id\":\"s0_1660\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772757501,\"id\":\"s0_1661\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Scout Nefina\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Scout Nefina says: I saw Faindel... one of the missing scouts! But he was wreathed in Void... shimmering like a mirage.\",\"timestamp\":1772757501,\"id\":\"s0_1662\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:249433::::::::87:1473::11::1:28:3321:::::|h[Void Splinter]|h|r\",\"timestamp\":1772757536,\"id\":\"s0_1663\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Starving Voidwalker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Starving Voidwalker says: Too weak... can't focus...\",\"timestamp\":1772757537,\"id\":\"s0_1664\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Scout Nefina\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Scout Nefina says: I didn't sign up to feed a voidwalker... but if there's a chance it can help...\",\"timestamp\":1772757540,\"id\":\"s0_1665\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6