e\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Our mother's bow meant everything to Sylvanas, once. I'll need it.\",\"id\":\"s0_4184\",\"timestamp\":1772950507},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kalis\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kalis yells: My Queen... we... failed...\",\"id\":\"s0_4185\",\"timestamp\":1772950604},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas was sometimes vain, and loved to be admired, but she never wanted to be worshipped.\",\"id\":\"s0_4186\",\"timestamp\":1772950608},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, we have one more relic to find.\",\"id\":\"s0_4187\",\"timestamp\":1772950616},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Lonelylitten|h[Lonelylitten]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s0_4188\",\"timestamp\":1772950659},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Lonelylitten|h[Lonelylitten]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s0_4189\",\"timestamp\":1772950660},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"R