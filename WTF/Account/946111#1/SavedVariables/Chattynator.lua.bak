:1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Badgrizly-Zul'jin|h[|cffa330c9Badgrizly-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:18167:Player-61-0FE5E6D6:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Edge of the Void]|h|r!\",\"timestamp\":1774129155,\"id\":\"s6_3989\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Dwarf\",\"name\":\"Nefarious-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Nefarious-Zul'jin|h[|cff8788eeNefarious-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:19338:Player-61-0FE541EF:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Council of Dreams]|h|r!\",\"timestamp\":1774129195,\"id\":\"s6_3990\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Tactusdh-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Tactusdh-Area52|h[|cffa330c9Tactusdh-Area52|r]|h has earned the achievement |cffffff00|Hachievement:61732:Player-3676-0EDBFAB0:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Sunkiller Sanctum Stories]|h|r!\",\"timestamp\":1774129242,\"id\":\"s6_3991\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Dwarf\",\"name\":\"Nefarious-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Nefarious-Zul'jin|h[|cff8788eeNefarious-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:19340:Player-61-0FE541EF:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Nymue, Weaver of the Cycle]|h|r!\",\"timestamp\":1774129325,\"id\":\"s6_3992\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I hunger for the opportunity to work together again. Come, let us forge a weapon worthy of your allies.\",\"timestamp\":1774129467,\"id\":\"s6_3993\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Dwarf\",\"name\":\"Nefarious-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Nefarious-Zul'jin|h[|cff8788eeNefarious-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:19341:Player-61-0FE541EF:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Smolderon]|h|r!\",\"timestamp\":1774129499,\"id\":\"s6_3994\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: The Den has been ravaged with vermin. If we deal with that problem the elders will be more favorable with us. Take a grymlinx--they are always up for a meal.\",\"id\":\"s6_3995\",\"timestamp\":1774129552},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Amarakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Amarakk says: Lesser manifestations escape from the rift. Send them back where they belong.\",\"id\":\"s6_3996\",\"timestamp\":1774129565},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Amarakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Amarakk says: The Pit attracts many threats. See that they do not spill out.\",\"id\":\"s6_3997\",\"timestamp\":1774129581},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"As you step inside, drawn ever closer to hidden treasure, your Coffer Key Shards stir as if awakened by the promise of riches. They shimmer, then fuse together, becoming whole once more.\",\"id\":\"s6_3998\",\"timestamp\":1774129590},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3028:0|h[Restored Coffer Key]|h|rx2\",\"id\":\"s6_3999\",\"timestamp\":1774129590},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Valeera Sanguinar begins making a campfire.\",\"id\":\"s6_4000\",\"timestamp\":1774129592},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Boletus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Boletus says: Good timing, crowd getting bored. Beat stuff up!\",\"id\":\"s6_4001\",\"timestamp\":1774129592},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Boletus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Boletus yells: We got fresh fighter!\",\"id\":\"s6_4002\",\"timestamp\":1774129599},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: I'll savor this strike.\",\"id\":\"s6_4003\",\"timestamp\":1774129616},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: I'll take that.\",\"id\":\"s6_4004\",\"timestamp\":1774129621},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Fungal Rotspreader\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fungal Rotspreader attempts to run away in fear!\",\"id\":\"s6_4005\",\"timestamp\":1774129626},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Fungal Stabber\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fungal Stabber attempts to run away in fear!\",\"id\":\"s6_4006\",\"timestamp\":1774129631},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Fungal Stabber\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fungal Stabber attempts to run away in fear!\",\"id\":\"s6_4007\",\"timestamp\":1774129631},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Gnarled Reviver\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Gnarled Reviver attempts to run away in fear!\",\"id\":\"s6_4008\",\"timestamp\":1774129635},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Gnarled Rev