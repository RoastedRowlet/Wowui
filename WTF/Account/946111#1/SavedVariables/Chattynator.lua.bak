!\",\"timestamp\":1773537368,\"id\":\"s3_3396\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: That... not be natural. And the energy flowing into it... This is hex magic.\",\"timestamp\":1773537370,\"id\":\"s3_3397\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: Using the souls of de dead in powerful magic spells... I hope this is not why they brought my kin here.\",\"timestamp\":1773537378,\"id\":\"s3_3398\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Gnome\",\"name\":\"Noxfrigia-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Noxfrigia receives loot: |cnIQ0:|Hitem:260614::::::::84:1480:::::::::|h[Unrecognizable Organ]|h|r.\",\"timestamp\":1773537418,\"id\":\"s3_3399\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: It be worse than we thought. How many of my people have died here?\",\"timestamp\":1773537435,\"id\":\"s3_3400\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Gnome\",\"name\":\"Noxfrigia-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Noxfrigia receives loot: |cnIQ0:|Hitem:260614::::::::84:1480:::::::::|h[Unrecognizable Organ]|h|r.\",\"timestamp\":1773537438,\"id\":\