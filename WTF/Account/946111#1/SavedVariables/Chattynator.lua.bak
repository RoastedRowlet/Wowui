},
["text"] = "Lor'themar Theron says: With what army, Arator? The Vanguard is gone.",
["timestamp"] = 1774142645,
["id"] = "s7_3148",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
