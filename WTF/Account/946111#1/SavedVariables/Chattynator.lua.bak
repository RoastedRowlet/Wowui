-Lightbringer:735:PARTY:|h[|cff00ff98Konviks-Lightbringer|r]|h: gg\",\"timestamp\":1773885483,\"id\":\"s5_4642\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Bannedvokex-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"r\":0.4627451300621033,\"g\":0.7843137979507446,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Bannedvokex-Area52:736:PARTY:|h[|cff33937fBannedvokex-Area52|r]|h: gg\",\"timestamp\":1773885486,\"id\":\"s5_4643\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Vulpera\",\"name\":\"Konviks-Lightbringer\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Konviks-Lightbringer receives loot: |cnIQ4:|Hitem:49823::::::::90:105::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Cloak of the Fallen Cardinal]|h|r.\",\"timestamp\":1773885487,\"id\":\"s5_4644\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Martin Victus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Martin Victus yells: Brave champions, we owe you our lives, our freedom.... Though it be a tiny gesture in the face of this enormous debt, I pledge that from this day forth, all will know of your deeds, and the blazing path of light you cut through the shadow of this dark citadel.\",\"timestamp\":1773885488,\"id\":\"s5_4645\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:2000|h[Loot]|h: You passed on: |cnIQ2:|Hitem:267007::::::::90:105:::::::::|h[Eye of Acherus]|h|r |HlootHistory:2000|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"timestamp\":1773885490,\"id\":\"s5_4646\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Orc\",\"name\":\"Chanyk-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"r\":0.4627451300621033,\"g\":0.7843137979507446,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Chanyk-Area52:742:PARTY:|h[|cff8788eeChanyk-Area52|r]|h: ty all\",\"timestamp\":1773885499,\"id\":\"s5_4647\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Martin Victus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Martin Victus yells: This day will stand as a testament not only to your valor, but to the fact that no foe, not even the Lich King himself, can stand when Alliance and Horde set aside their differences and---\",\"timestamp\":1773885503,\"id\":\"s5_4648\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Vulpera\",\"name\":\"Konviks-Lightbringer\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Konviks-Lightbringer:744:PARTY:|h[|cff00ff98Konviks-Lightbringer|r]|h: y'all gonna keep doing more?\",\"timestamp\":1773885514,\"id\":\"s5_4649\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Lady Jaina Proudmoore yells: NO! YOU MONSTER!\",\"timestamp\":1773885518,\"id\":\"s5_4650\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Lady Jaina Proudmoore yells: I... I could not save them... Damn you, Arthas! DAMN YOU!\",\"timestamp\":1773885521,\"id\":\"s5_4651\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:49817::::::::90:105::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r\",\"timestamp\":1773885522,\"id\":\"s5_4652\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:2000|h[Loot]|h: Konviks (Need - 2, Main-Spec) Won: |cnIQ2:|Hitem:267007::::::::90:105:::::::::|h[Eye of Acherus]|h|r\",\"timestamp\":1773885525,\"id\":\"s5_4653\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Vulpera\",\"name\":\"Konviks-Lightbringer\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Konviks-Lightbringer receives loot: |cnIQ2:|Hitem:267007::::::::90:105:::::::::|h[Eye of Acherus]|h|r.\",\"timestamp\":1773885525,\"id\":\"s5_4654\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"NightElf\",\"name\":\"Highwaym-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Highwaym-Stormrage:751:PARTY:|h[|cff00ff98Highwaym|r]|h: GGS\",\"timestamp\":1773885528,\"id\":\"s5_4655\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Jaina Proudmoore says: The Frost Queen is gone. We must keep moving - our objective is near.\",\"timestamp\":1773885528,\"id\":\"s5_4656\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Your |cnIQ4:|Hitem:49817::::::::90:105::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r was changed to |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12786:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r.\",\"timestamp\":1773885589,\"id\":\"s5_4657\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Your |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12786:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r was changed to |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12787:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r.\",\"timestamp\":1773885589,\"id\":\"s5_4658\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Your |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12787:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r was changed to |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12788:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r.\",\"timestamp\":1773885590,\"id\":\"s5_4659\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Your |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12788:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r was changed to |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12789:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r.\",\"timestamp\":1773885590,\"id\":\"s5_4660\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Your |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12789:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r was changed to |cnIQ4:|Hitem:49817::::::::90:105::23:5:13439:6652:13577:12699:12790:1:28:3025:::::|h[Shaggy Wyrmleather Leggings]|h|r.\",\"timestamp\":1773885590,\"id\":\"s5_4661\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Headteacher Doragosa\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Headteacher Doragosa yells: Welcome to Algeth'ar Academy! I am delighted that you received our invitation. The school is a touch behind schedule, but I have heard wondrous things about your capabilities. Perhaps you could help us?\",\"timestamp\":1773886024,\"id\":\"s5_4662\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"NightElf\",\"name\":\"Highwaym-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Highwaym-Stormrage:894:PARTY:|h[|cff00ff98Highwaym|r]|h: dungeon is on normal\",\"timestamp\":1773886032,\"id\":\"s5_4663\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: New students! How wonderful. It has been quite some time since the Academy has been open.\",\"timestamp\":1773886033,\"id\":\"s5_4664\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Red Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Red Dragonflight Recruiter says: Greetings! Have you considered pledging the Red Dragonflight? Anyone who is anyone will be. We are kind of a big deal.\",\"timestamp\":1773886036,\"id\":\"s5_4665\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Green Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Green Dragonflight Recruiter says: Hey, friend! I am still waking up, so please bear with me. Have you considered pledging the Green Dragonflight?\",\"timestamp\":1773886038,\"id\":\"s5_4666\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Indeed! Come with us! It should only take a moment to set up for a new lesson.\",\"timestamp\":1773886042,\"id\":\"s5_4667\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue Dragonflight Recruiter says: Ummm... excuse me... Ummm... Will you be matriculating at Algeth'ar Academy for the upcoming year? If so, have you considered pledging the Blue Dragonflight?\",\"timestamp\":1773886043,\"id\":\"s5_4668\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Auntique-MoonGuard\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Auntique-MoonGuard:900:PARTY:|h[|cfff48cbaAuntique-MoonGuard|r]|h: Shes loading\",\"timestamp\":1773886044,\"id\":\"s5_4669\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Auntique-MoonGuard\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Auntique-MoonGuard:901:PARTY:|h[|cfff48cbaAuntique-MoonGuard|r]|h: will fix in a sec\",\"timestamp\":1773886047,\"id\":\"s5_4670\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Bronze Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Bronze Dragonflight Recruiter says: You look in a hurry, but if I could borrow you for a second to pledge the Bronze Dragonflight I promise your time will be well spent.\",\"timestamp\":1773886052,\"id\":\"s5_4671\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Green Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Green Dragonflight Recruiter says: Hey, friend! I am still waking up, so please bear with me. Have you considered pledging the Green Dragonflight?\",\"timestamp\":1773886147,\"id\":\"s5_4672\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Indeed! Come with us! It should only take a moment to set up for a new lesson.\",\"timestamp\":1773886147,\"id\":\"s5_4673\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Well, it seems like things are in further disrepair than we anticipated.\",\"timestamp\":1773886153,\"id\":\"s5_4674\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: These lashers must have grown wild while we were away.\",\"timestamp\":1773886159,\"id\":\"s5_4675\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Please, if you could, clear them out while we realign the life magics of this place?\",\"timestamp\":1773886163,\"id\":\"s5_4676\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Perfect, we are just about--wait, Ichistrasz! There is too much life magic! What are you doing?\",\"timestamp\":1773886276,\"id\":\"s5_4677\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"tex