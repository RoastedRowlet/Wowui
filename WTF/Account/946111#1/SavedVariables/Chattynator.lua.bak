\":\"Arator says: You got the last conduit? Make sure to send them over.\",\"id\":\"s4_3399\",\"timestamp\":1773606876},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 19 Gold, 6 Silver, 76 Copper\",\"id\":\"s4_3400\",\"timestamp\":1773606877},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Lothraxion, this isn't what the Light demands of us.\",\"id\":\"s4_3401\",\"timestamp\":1773606893},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Think of the lives that will be lost--just trust us.\",\"id\":\"s4_3402\",\"timestamp\":1773606896},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You of them all, I thought would understand Arator. \",\"id\":\"s4_3403\",\"timestamp\":1773606899},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: A shame that the Void has corrupted you too.\",\"id\":\"s4_3404\",\"timestamp\":1773606905},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: The console is working--starting the bridge now!\",\"id\":\"s4_3405\",\"timestamp\":1773606915},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Medarasong-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Medarasong-Illidan|h[|cff3fc7ebMedarasong-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:62157:Player-57-0E15E330:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Sadistic Shamans (Hard)]|h|r!\",\"id\":\"s4_3406\",\"timestamp\":1773607052},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Cindooples-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Cindooples-Illidan|h[|cff0070ddCindooples-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:62337:Player-57-0DDCF426:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Abundance: Professional]|h|r!\",\"id\":\"s4_3407\",\"timestamp\":1773607082},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You will see.\",\"id\":\"s4_3408\",\"timestamp\":1773607119},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Stickfigure-Whisperwind\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Stickfigure-Whisperwind|h[|cff00ff98Stickfigure-Whisperwind|r]|h has earned the achievement |cffffff00|Hachievement:61647:Player-55-0AD3033D:1:3:15:26:4294967295:4294967295:4294