\",\"name\":\"Demonpotato-Korgath\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Demonpotato-Korgath receives loot: |cnIQ0:|Hitem:201424::::::::90:1480:::::::::|h[Unusable Plant Matter]|h|r.\",\"id\":\"s6_3643\",\"timestamp\":1773986363},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Zugter-Illidan receives loot: |cnIQ0:|Hitem:201424::::::::90:1480:::::::::|h[Unusable Plant Matter]|h|rx2.\",\"id\":\"s6_3644\",\"timestamp\":1773986365},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Professor Ichistrasz says: Me?! There is too much nature! What are you doing?\",\"id\":\"s6_3645\",\"timestamp\":1773986366},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Zugter-Illidan receives loot: |cnIQ0:|Hitem:201424::::::::90:1480:::::::::|h[Unusable Plant Matter]|h|rx2.\",\"id\":\"s6_3646\",\"timestamp\":1773986369},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Professor Mystakria says: What is that thing? This is your fault!\",\"id\":\"s6_3647\",\"timestamp\":1773986370},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"