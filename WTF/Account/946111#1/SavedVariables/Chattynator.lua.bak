ass\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Zugter-Illidan:1346:RAID:|h[|cffaad372Zugter-Illidan|r]|h: |cnIQ4:|Hitem:267645::::::::90:253::3::1:28:3607:::::|h[Dreamrift Vanquisher's Argent Trophy]|h|r\",\"id\":\"s6_3571\",\"timestamp\":1773984751},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Zugter-Illidan:1350:RAID:|h[|cffaad372Zugter-Illidan|r]|h: |cnIQ3:|Hitem:264246::::::::90:253::3::1:28:3607:::::|h[Eerie Iridescent Riftshroom]|h|r\",\"id\":\"s6_3572\",\"timestamp\":1773984757},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Zugter-Illidan:1574:RAID:|h[|cffaad372Zugter-Illidan|r]|h: |cnIQ2:|Hitem:112384::::::::90:253::::1:28:5914:::::|h[Reflecting Prism]|h|r\",\"id\":\"s6_3573\",\"timestamp\":1773985123},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Zugter-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Zugter-Illidan:1752:PARTY:|h[|cffaad372Zugter-Illidan|r]|h: we're on normal\",\"id\":\"s6_3574\",\"timestamp\":1773985517},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Headteacher Doragosa\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Headteacher Doragosa yells: Welcome to Algeth'ar Academy! I am delighted that you received our invitation. The school is a touch behind schedule, but I have heard wondrous things about your capabilities. Perhaps you could help us?\",\"id\":\"s6_3575\",\"timestamp\":1773985526},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Headteacher Doragosa\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Headteacher Doragosa yells: Welcome to Algeth'ar Academy! I am delighted that you received our invitation. The school is a touch behind schedule, but I have heard wondrous things about your capabilities. Perhaps you could help us?\",\"id\":\"s6_3576\",\"timestamp\":1773985553},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Bronze Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Bronze Dragonflight Recruiter says: You look in a hurry, but if I could borrow you for a second to pledge the Bronze Dragonflight I promise your time will be well spent.\",\"id\":\"s6_3577\",\"timestamp\":1773985571},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Sturdy Love Fool\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sturdy Love Fool says: I'm just not that into you.\",\"id\":\"s6_3578\",\"timestamp\":1773985572},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Sturdy Love Fool\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sturdy Love Fool says: I can do better.\",\"id\":\"s6_3579\",\"timestamp\":1773985590},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\