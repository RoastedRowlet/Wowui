},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Arator says: Then we will find an army! Xal'atath's Devouring Host will not stay in Quel'Danas forever. All of Azeroth is in danger.",
["timestamp"] = 1774142649,
["id"] = "s7_3149",
},
