6,\"b\":0},\"text\":\"Kairiandel-Alleria creates: |cnIQ3:|Hitem:239675::::::::90:105::13:3:12247:12246:12493:5:28:3615:29:49:30:36:38:4:40:2573:::::|h[Courtly Shoulders |A:Professions-ChatIcon-Quality-Tier1:17:15::1|a]|h|r.\",\"timestamp\":1773782049,\"id\":\"s4_4795\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Troll\",\"name\":\"Leftclick-Zul'jin\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Leftclick-Zul'jin|h[|cff3fc7ebLeftclick-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61805:Player-61-07914198:1:3:17:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 9 (Season 1)]|h|r!\",\"timestamp\":1773782200,\"id\":\"s4_4796\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Orc\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:4841:GUILD:|h[|cff0070ddDaí|r]|h: anyone for a m0 Algathar\",\"timestamp\":1773782353,\"id\":\"s4_4797\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Orc\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Bumlock-BleedingHollow:4842:GUILD:|h[|cff8788eeBumlock|r]|h: inv \",\"timestamp\":1773782362,\"id\":\"s4_4798\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Headteacher Doragosa\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Headteacher Doragosa yells: Welcome to Algeth'ar Academy! I am delighted that you received our invitation. The school is a touch behind schedule, but I have heard wondrous things about your capabilities. Perhaps you could help us?\",\"timestamp\":1773782482,\"id\":\"s4_4799\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue Dragonflight Recruiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue Dragonflight Recruiter says: Ummm... excuse me... Ummm... Will you be matriculating at Algeth'ar Academy for the upcoming year? If so, have you considered pledging the Blue Dragonflight?\",\"timestamp\":1773782493,\"id\":\"s4_4800\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: New students! How wonderful. It has been quite some time since the Academy has been open.\",\"timestamp\":1773782496,\"id\":\"s4_4801\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Indeed! Come with us! It should only take a moment to set up for a new lesson.\",\"timestamp\":1773782505,\"id\":\"s4_4802\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Well, it seems like things are in further disrepair than we anticipated.\",\"timestamp\":1773782507,\"id\":\"s4_4803\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: These lashers must have grown wild while we were away.\",\"timestamp\":1773782513,\"id\":\"s4_4804\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Please, if you could, clear them out while we realign the life magics of this place?\",\"timestamp\":1773782518,\"id\":\"s4_4805\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"NightElf\",\"name\":\"Sçruffy-TheScryers\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Sçruffy-TheScryers|h[|cffc41e3aSçruffy-TheScryers|r]|h has earned the achievement |cffffff00|Hachievement:61797:Player-75-0FE40902:1:3:17:26:4294967295:4294967295:4294967295:4294967295|h[My Shady Nemesis]|h|r!\",\"timestamp\":1773782530,\"id\":\"s4_4806\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Kovieyd-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kovieyd-Stormrage|h[|cffff7c0aKovieyd|r]|h has earned the achievement |cffffff00|Hachievement:61487:Player-60-0FDB33A0:1:3:17:26:4294967295:4294967295:4294967295:4294967295|h[Chimaerus, the Undreamt God]|h|r!\",\"timestamp\":1773782543,\"id\":\"s4_4807\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Perfect, we are just about--wait, Ichistrasz! There is too much life magic! What are you doing?\",\"timestamp\":1773782575,\"id\":\"s4_4808\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Me?! There is too much nature! What are you doing?\",\"timestamp\":1773782585,\"id\":\"s4_4809\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: What is that thing? This is your fault!\",\"timestamp\":1773782590,\"id\":\"s4_4810\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Ichistrasz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Ichistrasz says: Absolutely not!\",\"timestamp\":1773782594,\"id\":\"s4_4811\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Please help us, new students.\",\"timestamp\":1773782597,\"id\":\"s4_4812\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Mystakria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Professor Mystakria says: Thank you so much for your help. Though this all could have been avoided by someone not trying too hard.\",\"timestamp\":1773782714,\"id\":\"s4_4813\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Scourge\",\"name\":\"Officialorb-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Officialorb-Illidan receives loot: |cnIQ0:|Hitem:192608::::::::90:105:::::::::|h[Ancient Resin]|h|r.\",\"timestamp\":1773782715,\"id\":\"s4_4814\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ0:|Hitem:192608::::::::90:105:::::::::|h[Ancient Resin]|h|r.\",\"timestamp\":1773782716,\"id\":\"s4_4815\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:193712::::::::90:105::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Potion-Stained Cloak]|h|r\",\"timestamp\":1773782717,\"id\":\"s4_4816\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 14 Gold, 77 Silver, 28 Copper\",\"timestamp\":1773782717,\"id\":\"s4_4817\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Malinor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Malinor says: Look at this Lish Llrath arena--wait, what are these birds doing here?\",\"timestamp\":1773782770,\"id\":\"s4_4818\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Malinor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Malinor says: Clear them out! They have ruined the place.\",\"timestamp\":1773782800,\"id\":\"s4_4819\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Spell Bunny\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The eagles press their assault!\",\"timestamp\":1773782800,\"id\":\"s4_4820\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Dracthyr\",\"name\":\"Kairiandel-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Kairiandel-Alleria receives loot: |cnIQ0:|Hitem:192621::::::::90:105:::::::::|h[Long-Toed Talon]|h|r.\",\"timestamp\":1773782802,\"id\":\"s4_4821\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Malinor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Malinor says: So many birds! Help us get rid of them!\",\"timestamp\":1773782824,\"id\":\"s4_4822\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Spell Bunny\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"More eagles begin their approach.\",\"timestamp\":1773782824,\"id\":\"s4_4823\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:192621::::::::90:105:::::::::|h[Long-Toed Talon]|h|rx4\",\"timestamp\":1773782827,\"id\":\"s4_4824\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\"