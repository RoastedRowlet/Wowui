":\"|HlootHistory:3059|h[Loot]|h: |cnIQ2:|Hitem:256683::::::::90:1480::23:::::::|h[Silvermoon Training Dummy]|h|r\",\"id\":\"s4_3351\",\"timestamp\":1773605965},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Stickfigure-Whisperwind\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Stickfigure-Whisperwind receives loot: |cnIQ4:|Hitem:251096::::::::90:1480::23:5:12779:13439:6652:13668:12699:1:28:3025:::::|h[Pendant of Aching Grief]|h|r.\",\"id\":\"s4_3352\",\"timestamp\":1773605966},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 32 Gold, 17 Silver, 48 Copper\",\"id\":\"s4_3353\",\"timestamp\":1773605968},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3341:0|h[Veteran Dawncrest]|h|rx10\",\"id\":\"s4_3354\",\"timestamp\":1773605969},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: At last... the spirits that linger within these halls have found peace.\",\"id\":\"s4_3355\",\"timestamp\":1773605969},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3059|h[Loot]|h: You passed on: |cnIQ2:|Hitem:256683::::::::90:1480::23:::::::|h[Silvermoon Training Dummy]|h|r |HlootHistory:3059|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"id\":\"s4_3356\",\"timestamp\":1773605970},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3059|h[Loot]|h: Meleona (Need - 81, Main-Spec) Won: |cnIQ2:|Hitem:256683::::::::90:1480::23:::::::|h[Silvermoon Training Dummy]|h|r\",\"id\":\"s4_3357\",\"timestamp\":1773605974},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"DRUID\",\"name\":\"Meleona-Sargeras\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Meleona-Sargeras receives loot: |cnIQ2:|Hitem:256683::::::::90:1480::23:::::::|h[Silvermoon Training Dummy]|h|r.\",\"id\":\"s4_3358\",\"timestamp\":1773605974},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: I hope that one day my sisters will be able to do the same.\",\"id\":\"s4_3359\",\"timestamp\":1773605975},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Officialclaw-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Officialclaw-Illidan:2952:PARTY:|h[|cffff7c0aOfficialclaw-Illidan|r]|h: gg\",\"id\":\"s4_3360\",\"timestamp\":1773605978},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: As for myself... I shall fill these halls with music until they return home. Thank you, champions.\",\"id\":\"s4_3361\",\"timestamp\":1773605980},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"HUNTER\",\"name\":\"Brushe-EmeraldDream\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Brushe-EmeraldDream:2954:PARTY:|h[|cffaad372Brushe-EmeraldDream|r]|h: gg\",\"id\":\"s4_3362\",\"timestamp\":1773605983},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\" says: \",\"id\":\"s4_3363\",\"timestamp\":1773606054},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"id\":\"s4_3364\",\"timestamp\":1773606171},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"id\":\"s4_3365\",\"timestamp\":1773606177},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"id\":\"s4_3366\",\"timestamp\":1773606183},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Circuit Seer\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Circuit Seer yells: The pylon is showing near critical failure, Chief Corewright!\",\"id\":\"s4_3367\",\"timestamp\":1773606188},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: Hurry up those repairs. If we aren't careful, that will be all of us!\",\"id\":\"s4_3368\",\"timestamp\":1773606191},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 10 Gold, 62 Silver, 33 Copper\",\"id\":\"s4_3369\",\"timestamp\":1773606255},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: More of you mindless intruders!\",\"id\":\"s4_3370\",\"timestamp\":1773606369},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: But my job isn't done... There's still...\",\"id\":\"s4_3371\",\"timestamp\":1773606462},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Officialclaw-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Officialclaw-Illidan receives loot: |cnIQ4:|Hitem:251204::::::::90:1480::23:5:12779:13439:43:12699:13577:1:28:3025:::::|h[Corewright's Zappers]|h|r.\",\"id\":\"s4_3372\",\"timestamp\":1773606463},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 27 Gold, 10 Silver, 48 Copper\",\"id\":\"s4_3373\",\"timestamp\":1773606466},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Don't forget to send the conduits.\",\"id\":\"s4_3374\",\"timestamp\":1773606466},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You will realize I was right, Alleria.\",\"id\":\"s4_3375\",\"timestamp\":1773606478},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: Your judgment has been clouded by the Void. As it always does!\",\"id\":\"s4_3376\",\"timestamp\":1773606482},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: My vision has never been clearer Lothraxion, but I don't want to believe it. \",\"id\":\"s4_3377\",\"timestamp\":1773606487},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Corewarden Nysarra yells: What a miserable display! You have all failed in your purpose!\",\"id\":\"s4_3378\",\"timestamp\":1773606585},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Corewarden Nysarra yells: Is there no end to you intruders? Do us all a favor and die before I have to kill you myself.\",\"id\":\"s4_3379\",\"timestamp\":1773606643},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Corewarden Nysarra yells: Prove your worth, you pathetic lackeys.\",\"id\":\"s4_3380\",\"timestamp\":1773606664},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Officialclaw-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Officialclaw-Illidan receives loot: |cnIQ0:|Hitem:260677::::::::90:1480:::::::::|h[Void Flakes]|h|r.\",\"id\":\"s4_3381\",\"timestamp\":1773606667},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Stickfigure-Whisperwind\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Stickfigure-Whisperwind receives loot: |cnIQ0:|Hitem:260659::::::::90:1480:::::::::|h[Stellar Vortex Residue]|h|rx2.\",\"id\":\"s4_3382\",\"timestamp\":1773606668},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"WARRIOR\",\"name\":\"Binkley-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Binkley-Dalaran receives loot: |cnIQ0:|Hitem:260659::::::::90:1480:::::::::|h[Stellar Vortex Residue]|h|r.\",\"id\":\"s4_3383\",\"timestamp\":1773606669},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Corewarden Nysarra yells: Minions, do not disappoint me again.\",\"id\":\"s4_3384\",\"timestamp\":1773606720},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260654::::::::90:1480:::::::::|h[Abrasive Sand]|h|r\",\"id\":\"s4_3385\",\"timestamp\":1773606727},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260659::::::::90:1480:::::::::|h[Stellar Vortex Residue]|h|rx2\",\"id\":\"s4_3386\",\"timestamp\":1773606727},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260638::::::::90:1480:::::::::|h[Fine Void Residue]|h|r\",\"id\":\"s4_3387\",\"timestamp\":1773606727},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Corewarden Nysarra yells: Must I do everything myself?\",\"id\":\"s4_3388\",\"timestamp\":1773606757},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Stickfigure-Whisperwind\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Stickfigure-Whisperwind 