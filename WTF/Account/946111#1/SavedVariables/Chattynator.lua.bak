\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:251285::::::::90:105:::::::::|h[Petrified Root]|h|rx6\",\"timestamp\":1773177863,\"id\":\"s1_3659\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 28 Gold, 1 Silver, 86 Copper\",\"timestamp\":1773177864,\"id\":\"s1_3660\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: At last... the spirits that linger within these halls have found peace.\",\"timestamp\":1773177864,\"id\":\"s1_3661\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3341:0|h[Veteran Dawncrest]|h|rx10\",\"timestamp\":1773177864,\"id\":\"s1_3662\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: I hope that one day my sisters will be able to do the same.\",\"timestamp\":1773177870,\"id\":\"s1_3663\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: As for myself... I shall fill these halls with music until they return home. Thank you, champions.\",\"timestamp\":1773177875,\"id\":\"s1_3664\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:251099::::::::90:105::23:5:12779:13439:6652:12699:13577:1:28:3025:::::|h[Vest of the Howling Gale]|h|r\",\"timestamp\":1773177877,\"id\":\"s1_3665\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Lonelylitten-Stormrage|h[|cffff7c0aLonelylitten|r]|h has earned the achievement |cffffff00|Hachievement:61678:Player-60-0F85ABEF:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Superior]|h|r!\",\"timestamp\":1773177882,\"id\":\"s1_3666\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Lonelylitten-Stormrage|h[|cffff7c0aLonelylitten|r]|h has earned the achievement |cffffff00|Hachievement:61678:Player-60-0F85ABEF:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Superior]|h|r!\",\"timestamp\":1773177882,\"id\":\"s1_3667\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:3059|h[Loot]|h: You have selected Greed for: |cnIQ2:|Hitem:256683::::::::90:105::23:::::::|h[Silvermoon Training Dummy]|h|r |HlootHistory:3059|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"timestamp\":1773177949,\"id\":\"s1_3668\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:3059|h[Loot]|h: Impuratus (Need - 83, Main-Spec) Won: |cnIQ2:|Hitem:256683::::::::90:105::23:::::::|h[Silvermoon Training Dummy]|h|r\",\"timestamp\":1773177949,\"id\":\"s1_3669\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"The guards' eyes are on you. Return to neutral territory.\",\"timestamp\":1773178074,\"id\":\"s1_3670\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: Lonelylitten. Oraka'zul! I am blessed ya be here to prowl with me.\",\"timestamp\":1773178147,\"id\":\"s1_3671\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: I have used de shadows to see inside de cavern. I have seen my people--dead, alive, or... both.\",\"timestamp\":1773178152,\"id\":\"s1_3672\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: I fear they be sacrificed for some dark purpose. Come. I will guide you. We gonna rescue my people.\",\"timestamp\":1773178160,\"id\":\"s1_3673\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Sturdy Love Fool\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sturdy Love Fool says: We can still be friends.\",\"timestamp\":1773178195,\"id\":\"s1_3674\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Sturdy Love Fool\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sturdy Love Fool says: I'm just not that into you.\",\"timestamp\":1773178224,\"id\":\"s1_3675\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Frenzied Berserker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Frenzied Berserker yells: Intruders! Cut dem down!\",\"timestamp\":1773178259,\"id\":\"s1_3676\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ0:|Hitem:260651::::::::90:105:::::::::|h[Lustrous Wildlife Pelt]|h|r.\",\"timestamp\":1773178294,\"id\":\"s1_3677\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"BloodElf\",\"name\":\"Frostyfae-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Frostyfae-Illidan receives loot: |cnIQ0:|Hitem:260614::::::::90:105:::::::::|h[Unrecognizable Organ]|h|r.\",\"timestamp\":1773178298,\"id\":\"s1_3678\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\