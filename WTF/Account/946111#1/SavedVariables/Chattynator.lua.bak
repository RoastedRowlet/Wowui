1\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: The Ranger-General was sharp and steadfast, while the peacekeeper kept the calm. Which path will you choose?\",\"timestamp\":1773598172,\"id\":\"s4_2912\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Draenei\",\"name\":\"Justzeus-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Justzeus receives loot: |cnIQ2:|Hitem:258920::::::::89:1480::133:2:13729:13578:2:9:80:28:3022:::::|h[Tarnished Dawnlit Corsair's Tunic]|h|r.\",\"timestamp\":1773598210,\"id\":\"s4_2913\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Vereesa was the peacekeeper of our family. She spent many days tending to the gardens here, but the wilderness has overtaken it now.\",\"timestamp\":1773598225,\"id\":\"s4_2914\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"VoidElf\",\"name\":\"Zenie-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Zenie-Stormrage|h[|cff00ff98Zenie|r]|h has earned the achievement |cffffff00|Hachievement:62238:Player-60-0C48283F:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Tailoring-on-Demand]|h|r!\",\"timestamp\":1773598247,\"id\":\"s4_2915\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Draenei\",\"name\":\"Justzeus-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Justzeus receives loot: |cnIQ1:|Hitem:242639::::::::89:1480:::::::::|h[Practically Pork]|h|rx2.\",\"timestamp\":1773598310,\"id\":\"s4_2916\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Draenei\",\"name\":\"Justzeus-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Justzeus receives loot: |cnIQ0:|Hitem:260665::::::::89:1480:::::::::|h[Sizable Tusk]|h|r.\",\"timestamp\":1773598310,\"id\":\"s4_2917\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: The soothing sounds of my harp brought Vereesa joy beyond measure. I'll need that relic.\",\"timestamp\":1773598343,\"id\":\"s4_2918\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Travisty-Aggramar\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Travisty-Aggramar receives loot: |cnIQ0:|Hitem:260621::::::::89:1480:::::::::|h[Magic Infused Bark]|h|r.\",\"timestamp\":1773598399,\"id\":\"s4_2919\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"timestamp\":1773598403,\"id\":\"s4_2920\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"co