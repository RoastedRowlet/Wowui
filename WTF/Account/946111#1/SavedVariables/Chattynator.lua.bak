rdedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"[Leader] |Hplayer:Catöflight|h[Catöflight]: |h|A:ping_chat_threat:0:0:0:0|aThreatening alert: Arcane Magister\",\"timestamp\":1773506119,\"id\":\"s2_4885\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Kalladain-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Kalladain receives loot: |cnIQ0:|Hitem:260646::::::::80:1480:::::::::|h[Glowing Gland]|h|r.\",\"timestamp\":1773506137,\"id\":\"s2_4886\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Dwarf\",\"name\":\"Catöflight-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Catöflight receives loot: |cnIQ0:|Hitem:260676::::::::80:1480:::::::::|h[Unremarkable Crystal]|h|r.\",\"timestamp\":1773506138,\"id\":\"s2_4887\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arcane Sentry\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arcane Sentry yells: Unauthorized entry. Please hold.\",\"timestamp\":1773506141,\"id\":\"s2_4888\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: To think Rommath would go this far to keep me out...\",\"timestamp\":1773506146,\"id\":\"s2_4889\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: You'll go no further, Umbric. These new defenses were specially made with you in mind.\",\"timestamp\":1773506155,\"id\":\"s2_4890\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: I seem to be... detained. The construct ahead is heightening Rommath's spellwork. Destroy it.\",\"timestamp\":1773506162,\"id\":\"s2_4891\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arcane Sentry\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arcane Sentry says: Have... a... pleasant... day...\",\"timestamp\":1773506170,\"id\":\"s2_4892\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Kalladain-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Kalladain receives loot: |cnIQ3:|Hitem:258936::::::::80:1480::134:3:13730:6652:13578:2:9:84:28:3022:::::|h[Tarnished Dawnlit Commander's Breastplate]|h|r.\",\"timestamp\":1773506242,\"id\":\"s2_4893\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Kalladain-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Kalladain receives loot: |cnIQ0:|Hitem:260676::::::::80:1480:::::::::|h[Unremarkable Crystal]|h|r.\",\"timestamp\":1773506242,\"id\":\"s2_4894\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arcanotron Custos\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\