},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: Lonelylitten. Oraka'zul! I am blessed ya be here to prowl with me.",
["timestamp"] = 1774329659,
["id"] = "s7_4913",
},
{
