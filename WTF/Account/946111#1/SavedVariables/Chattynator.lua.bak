rdedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Troll\",\"class\":\"DRUID\",\"name\":\"Bëëpbeep-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Bëëpbeep-Area52|h[|cffff7c0aBëëpbeep|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-3676-0E032035:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s0_1413\",\"timestamp\":1772752916},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Troll\",\"class\":\"HUNTER\",\"name\":\"Ragehunting-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Ragehunting-Area52|h[|cffaad372Ragehunting|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-3676-0E4CFD85:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s0_1414\",\"timestamp\":1772752941},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: My sisters were the last to visit these halls, but they threw their home and their bond away. If we can calm the spirits here, maybe they'll return.\",\"id\":\"s0_1415\",\"timestamp\":1772752993},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The Ranger-General was sharp and steadfast, while the peacekeeper kept the calm. Which path will you choose?\",\"id\":\"s0_1416\",\"timestamp\":1772753007},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\"