timestamp\":1773376221,\"id\":\"s2_3879\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:242789::::::::90:1473:::::::::|h[Duskshrouded Stone |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|r\",\"timestamp\":1773376234,\"id\":\"s2_3880\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:237361::::::::90:1473:::::::::|h[Refulgent Copper Ore |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|rx3\",\"timestamp\":1773376235,\"id\":\"s2_3881\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:240947::::::::90:1473::13:8:12249:12248:4785:12497:13453:8960:8790:13620:8:28:3615:29:49:30:36:38:8:40:3126:45:251487:46:245786:47:-2147480307:::::|h[Gleaming Copper Band |A:Professions-ChatIcon-Quality-Tier5:17:15::1|a]|h|r\",\"timestamp\":1773376282,\"id\":\"s2_3882\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"BloodElf\",\"name\":\"Rhaastie-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Rhaastie-Area52|h[|cffffffffRhaastie|r]|h has earned the achievement |cffffff00|Hachievement:41804:Player-3676-0EDADBFD:1:3:12:26:4294967295:4294967295:4294967295:4294967295|h[One Does Not Simply Walk Into Harandar]|h|r!\",\"timestamp\":1773376393,\"id\":\"s2_3883\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: A rare honor is yours, Barelynoer: to discover the secret behind this fungarian spear. I look forward to what you uncover.\",\"timestamp\":1773376471,\"id\":\"s2_3884\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Fungarian tenacity meets rutaani thorns, and all of Harandar bleeds. We haranir step in, not to win a war, but to prune it before the rot consumes all.\",\"timestamp\":1773376521,\"id\":\"s2_3885\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Fungarian Brawler\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Fungarian Brawler says: My cap broken... Russula will avenge...\",\"timestamp\":1773376548,\"id\":\"s2_3886\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Fungarian Brawler\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Fungarian Brawler says: Russula will snap you twigs!\",\"timestamp\":1773376548,\"id\":\"s2_3887\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Skirmisher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rutaani Skirmisher says: We will grow back!\",\"timestamp\":1773376548,\"id\":\"s2_3888\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Skirmisher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rutaani Skirmisher says: Fungal rot... must be cleansed...\",\"timestamp\":1773376548,\"id\":\"s2_3889\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The first skirmish is halted, yet anger still simmers. The leaders of both sides refuse to reason except for one.\",\"timestamp\":1773376548,\"id\":\"s2_3890\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 3 Gold, 45 Silver, 78 Copper\",\"timestamp\":1773376551,\"id\":\"s2_3891\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Roonek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Roonek says: This one hears... but the petals have fallen. Only thorns remain.\",\"timestamp\":1773376560,\"id\":\"s2_3892\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Pustulehelm\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Pustulehelm says: Boring! No deal! They snap stalks, we snap back harder! Tell rutaani no cry when spores fly next!\",\"timestamp\":1773376573,\"id\":\"s2_3893\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Russula\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Russula yells: You! Fighter with brain! Come quick, want peace words!\",\"timestamp\":1773376574,\"id\":\"s2_3894\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Behold Russula, an advocate for mercy whose plea was drowned by the drums of war. But Russula knew how to make their voice heard over the din.\",\"timestamp\":1773376581,\"id\":\"s2_3895\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Grown to a size that none could ignore, the fungarian used their might to put an end to the battle. Their actions were to separate the combatants, not break them.\",\"timestamp\":1773376620,\"id\":\"s2_3896\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Fungarian says: Stop! You bash sense in us. Big ouch, bigger lesson!\",\"timestamp\":1773376630,\"id\":\"s2_3897\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Rutaani says: This one bleeds... but from pride. It is shorn.\",\"timestamp\":1773376631,\"id\":\"s2_3898\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Rutaani says: There is no honor in endless pruning. This one rests.\",\"timestamp\":1773376634,\"id\":\"s2_3899\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Fungarian says: Okay, okay! Peace talk! No more bonks!\",\"timestamp\":1773376636,\"id\":\"s2_3900\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Fungarian says: I not lose, just... resting.\",\"timestamp\":1773376641,\"id\":\"s2_3901\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Fungarian says: Okay, Russula not boring peace shroom. Peace shroom with fist!\",\"timestamp\":1773376646,\"id\":\"s2_3902\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Rutaani says: Peace not wanted... but perhaps needed.\",\"timestamp\":1773376647,\"id\":\"s2_3903\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warbound Rutaani says: Peace not wanted... but perhaps needed.\",\"timestamp\":1773376649,\"id\":\"s2_3904\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: With the fighting ended, they lay down their spear and asked the haranir to stop the killing. This is Russula's lesson: strength can bring victory, but tempered with mercy, it brings a greater victory.\",\"timestamp\":1773376649,\"id\":\"s2_3905\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3383:0|h[Adventurer Dawncrest]|h|rx10\",\"timestamp\":1773376650,\"id\":\"s2_3906\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3363:0|h[Community Coupons]|h|rx10\",\"timestamp\":1773376650,\"id\":\"s2_3907\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:268487::::::::90:1473::11::2:9:90:28:3321:::::|h[Avid Learner's Supply Pack]|h|r\",\"timestamp\":1773376684,\"id\":\"s2_3908\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: May Russula's Outreach remind us to temper our claws. Harandar endures longest when mercy guides the hunt.\",\"timestamp\":1773376684,\"id\":\"s2_3909\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx100\",\"timestamp\":1773376684,\"id\":\"s2_3910\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:257007::::::::90:1473::25:2:12769:6652:1:28:3321:::::|h[Tanglevine Spellfocus]|h|r\",\"timestamp\":1773376690,\"id\":\"s2_3911\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx20\",\"timestamp\":1773376691,\"id\":\"s2_3912\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx100\",\"timestamp\":1773376691,\"id\":\"s2_3913\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Scourge\",\"name\":\"Berodelm-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Berodelm-Area52|h[|cff8788eeBerodelm|r]|h has earned the achievement |cffffff00|Hachievement:1797:Player-3676-0EACA5B9:1:3:12:26:4294967295:4294967295:4294967295:4294967295|h[Chef de Partie]|h|r!\",\"timestamp\":1773376763,\"id\":\"s2_3914\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:263976::::::::90:1473:::::::::|h[Bundle of Adventurer Dawncrests]|h|r\",\"timestamp\":1773376987,\"id\":\"s2_3915\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx10\",\"timestamp\":1773377002,\"id\":\"s2_3916\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: My colleagues are searching for methods to protect our city. I have my own solution.\",\"timestamp\":1773377063,\"id\":\"s2_3917\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Meet me near the harbor and I will reveal to you another path...\",\"timestamp\":1773377072,\"id\":\"s2_3918\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Sanctum Attendant\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sanctum Attendant says: Magister Bloodsworn and his guest are waiting for you below.\",\"timestamp\":1773377112,\"id\":\"s2_3919\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: I have been tracking these threats to our realm for some time. They are quite tenacious.\",\"timestamp\":1773377121,\"id\":\"s2_3920\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: This crystal vessel... it's made from an unusually resilient cosmic material. Fascinating.\",\"timestamp\":1773377125,\"id\":\"s2_3921\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Release me and we will see who is \\\"prey.\\\"\",\"timestamp\":1773377128,\"id\":\"s2_3922\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: As if it were made to withstand something as volatile as anguish... This bodes well.\",\"timestamp\":1773377134,\"id\":\"s2_3923\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: The crystal reacts favorably to your touch. Duly noted.\",\"timestamp\":1773377140,\"id\":\"s2_3924\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Lucky dracthyr.\",\"timestamp\":1773377157,\"id\":\"s2_3925\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: A skilled hunter is capable of disarming any trap placed before them.\",\"timestamp\":1773377157,\"id\":\"s2_3926\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: A hasty hunter is oft bitten...\",\"timestamp\":1773377160,\"id\":\"s2_3927\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Ha! Got you good. Wait... what is that?\",\"timestamp\":1773377160,\"id\":\"s2_3928\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: I am well positioned to turn pain into power...\",\"timestamp\":1773377166,\"id\":\"s2_3929\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Raaaagh!\",\"timestamp\":1773377166,\"id\":\"s2_3930\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Be careful, champion. Our magic is almost as deadly as our prey.\",\"timestamp\":1773377183,\"id\":\"s2_3931\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: If you give them an inch, they will seek to claim the upper hand.\",\"timestamp\":1773377186,\"id\":\"s2_3932\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260673::::::::90:1473:::::::::|h[Partially Digested Bracers]|h|r\",\"timestamp\":1773377202,\"id\":\"s2_3933\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Aaaggh! I kill you!\",\"timestamp\":1773377207,\"id\":\"s2_3934\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captured Gnarldin says: Surprise, dracthyr!\",\"timestamp\":1773377211,\"id\":\"s2_3935\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Do you feel it? Do you feel the power? The anguish?\",\"timestamp\":1773377229,\"id\":\"s2_3936\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: I knew you could handle yourself, but that was truly delightful to watch.\",\"timestamp\":1773377236,\"id\":\"s2_3937\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Go now and hunt! But be careful, lest you become prey yourself.\",\"timestamp\":1773377283,\"id\":\"s2_3938\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: The domanaar are Xal'atath's elite, and therefore a most enticing target...\",\"timestamp\":1773377299,\"id\":\"s2_3939\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1773377347,\"id\":\"s2_3940\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Your target is harvesting power here. Destroy the sources and evade their little guards.\",\"timestamp\":1773377381,\"id\":\"s2_3941\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Barelynoer\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Ambushed!\",\"timestamp\":1773377388,\"id\":\"s2_3942\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Praetor Singularis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Praetor Singularis says: You'll make fine fodder for the pits.\",\"timestamp\":1773377389,\"id\":\"s2_3943\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Subtlety isn't your strength, is it?\",\"timestamp\":1773377392,\"id\":\"s2_3944\"},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Praetor Singularis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Praetor Singularis says: