6\",\"timestamp\":1773553612},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: More of you mindless intruders!\",\"id\":\"s3_4597\",\"timestamp\":1773553753},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: But my job isn't done... There's still...\",\"id\":\"s3_4598\",\"timestamp\":1773553834},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 16 Gold, 12 Silver, 19 Copper\",\"id\":\"s3_4599\",\"timestamp\":1773553837},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ3:|Hitem:251204::::::::86:1480::17:3:13441:13436:13578:2:9:84:28:3022:::::|h[Corewright's Zappers]|h|r.\",\"id\":\"s3_4600\",\"timestamp\":1773553837},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Don't forget to send the conduits.\",\"id\":\"s3_4601\",\"timestamp\":1773553838},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You will realize I was right, Alleria.\",\"id\":\"s3_4602\",\"timestamp\":1773553850},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: Your judgment has been clouded by the Void. As it always does!\",\"id\":\"s3_4603\",\"timestamp\":1773553854},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: My vision has never been clearer Lothraxion, but I don't want to believe it. \",\"id\":\"s3_4604\",\"timestamp\":1773553859},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Zahanay-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Zahanay-Proudmoore receives loot: |cnIQ0:|Hitem:260659::::::::86:1480:::::::::|h[Stellar Vortex Residue]|h|rx2.\",\"id\":\"s3_4605\",\"timestamp\":1773553975},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Drpoppler-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Drpoppler-Proudmoore receives loot: |cnIQ0:|Hitem:260659::::::::86:1480:::::::::|h[Stellar Vortex Residue]|h|rx4.\",\"id\":\"s3_4606\",\"timestamp\":1773553979},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Zahanay-Proudmoore\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Zahanay-Proudmoore receives loot: |cnIQ0:|Hitem:260659::::::::86:1480:::::::::|h[Stellar Vortex Residue]|h|r.\",\