":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: We still have much to learn of this place. Good work!\",\"timestamp\":1773595420,\"id\":\"s4_2758\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx230\",\"timestamp\":1773595421,\"id\":\"s4_2759\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: This area is compromised. It is vital to our mission that you secure it.\",\"timestamp\":1773595437,\"id\":\"s4_2760\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1773595438,\"id\":\"s4_2761\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Researcher Verigien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Researcher Verigien says: There are so many  fascinating flora and fauna to record.\",\"timestamp\":1773595445,\"id\":\"s4_2762\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1773595505,\"id\":\"s4_2763\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Darkglen says: The Void has a curious impact on the life of this world. Reach into these creatures and capture their instincts. I must know what fuels them.\",\"timestamp\":1773595507,\"id\":\"s4_2764\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Darkglen says: No sign of infection in these two either? Ah, Angryabsol! A moment, please.\",\"timestamp\":1773595514,\"id\":\"s4_2765\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Angryabsol-Stormrage|h[|cffa330c9Angryabsol|r]|h has earned the achievement |cffffff00|Hachievement:16566:Player-60-0C9E885E:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Great Shot!]|h|r!\",\"timestamp\":1773595519,\"id\":\"s4_2766\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Angryabsol-Stormrage|h[|cffa330c9Angryabsol|r]|h has earned the achievement |cffffff00|Hachievement:16566:Player-60-0C9E885E:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Great Shot!]|h|r!\",\"timestamp\":1773595519,\"id\":\"s4_2767\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Darkglen says: Survival at any cost. Finally, a world with sensible rules.\",\"timestamp\":1773595565,\"id\":\"s4_2768\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx207\",\"timestamp\":1773595566,\"id\":\"s4_2769\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1773595569,\"id\":\"s4_2770\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: The Shadowguard's machinations continue in spite of our best efforts. Disrupt their operations.\",\"timestamp\":1773595588,\"id\":\"s4_2771\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: The Den has been ravaged with vermin. If we deal with that problem the elders will be more favorable with us. Take a grymlinx--they are always up for a meal.\",\"timestamp\":1773595675,\"id\":\"s4_2772\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1773595711,\"id\":\"s4_2773\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Bitterbloom flowered overnight in Har'alnor. Burn it before it spreads any further.\",\"timestamp\":1773595731,\"id\":\"s4_2774\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:257000::::::::89:1480::74:2:13613:13578:2:9:89:28:3321:::::|h[Verdant Tracker's Trophy Mantle]|h|r\",\"timestamp\":1773595827,\"id\":\"s4_2775\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Good work. We need to always be wary and keep the Blinding Bloom in check.\",\"timestamp\":1773595828,\"id\":\"s4_2776\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx34\",\"timestamp\":1773595828,\"id\":\"s4_2777\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Those blasted Petalwings stole my rucksack... again. Will you help me retrieve my things from their nests?\",\"timestamp\":1773595854,\"id\":\"s4_2778\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:256144::::::::89:1480:::::::::|h[Bone Comb]|h|r\",\"timestamp\":1773595871,\"id\":\"s4_2779\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:256145::::::::89:1480:::::::::|h[Bird Whistle]|h|r\",\"timestamp\":1773595883,\"id\":\"s4_2780\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:256143::::::::89:1480:::::::::|h[Wooden Spoon]|h|r\",\"timestamp\":1773595934,\"id\":\"s4_2781\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:256138::::::::89:1480:::::::::|h[Har'old]|h|r\",\"timestamp\":1773595950,\"id\":\"s4_2782\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:252957::::::::89:1480::74:1:13613:2:9:89:28:3321:::::|h[Tangle of Vibrant Vines]|h|r\",\"timestamp\":1773595951,\"id\":\"s4_2783\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Please don't tell Elder Hagar about this. I will never hear the end of it.\",\"timestamp\":1773595951,\"id\":\"s4_2784\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx34\",\"timestamp\":1773595952,\"id\":\"s4_2785\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Ziadan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ziadan says: That looks like a treasure out in the distance. Don't miss this opportunity!\",\"timestamp\":1773596084,\"id\":\"s4_2786\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ranger Telenus says: Look at this mess!\",\"timestamp\":1773596136,\"id\":\"s4_2787\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Silvermoon Guard\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Silvermoon Guard says: Careful not to destroy another tree with the fel magic you brazenly wield.\",\"timestamp\":1773596153,\"id\":\"s4_2788\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Camberon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Camberon says: I'm far too busy to keep up with your training, but you're welcome to use my cau