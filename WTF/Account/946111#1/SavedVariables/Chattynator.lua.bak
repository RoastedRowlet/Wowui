2_4804\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"timestamp\":1773504327,\"id\":\"s2_4805\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"timestamp\":1773504333,\"id\":\"s2_4806\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"timestamp\":1773504339,\"id\":\"s2_4807\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Dwarf\",\"name\":\"Sinsual-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Sinsual receives loot: |cnIQ0:|Hitem:260659::::::::80:1480:::::::::|h[Stellar Vortex Residue]|h|rx2.\",\"timestamp\":1773504403,\"id\":\"s2_4808\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"DarkIronDwarf\",\"name\":\"Mezzyy-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Mezzyy receives loot: |cnIQ0:|Hitem:260638::::::::80:1480:::::::::|h[Fine Void Residue]|h|r.\",\"timestamp\":1773504444,\"id\":\"s2_4809\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"