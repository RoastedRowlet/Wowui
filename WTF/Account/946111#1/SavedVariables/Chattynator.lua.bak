ard)]|h|r!\",\"timestamp\":1773365499,\"id\":\"s2_3532\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Rhokadin-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_WHISPER_INFORM\",\"type\":\"WHISPER\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":1},\"text\":\"To |Hplayer:Rhokadin-Stormrage:759:WHISPER:RHOKADIN-STORMRAGE|h[|cfff48cbaRhokadin|r]|h: I can! R5 guaranteed.\",\"timestamp\":1773365826,\"id\":\"s2_3533\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Aláre-Zul'jin\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Aláre-Zul'jin|h[|cfff48cbaAláre-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61679:Player-61-0FE4D456:1:3:12:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Epic]|h|r!\",\"timestamp\":1773366123,\"id\":\"s2_3534\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Dazuren-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Dazuren-Zul'jin|h[|cff33937fDazuren-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:62235:Player-61-0EFF184F:1:3:12:26:4294967295:4294967295:4294967295:4294967295|h[Inscription-on-Demand]|h|r!\",\"timestamp\":1773366545,\"id\":\"s2_3535\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Solwin Brightstitch says: Alas, if I had but one worthy customer...\",\"timestamp\":1773366801,\"id\":\"s2_3536\"},{\"recordedBy\":\"Lonelylitten-Stormrage