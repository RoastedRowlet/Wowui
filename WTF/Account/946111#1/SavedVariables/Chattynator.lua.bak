\"race\":\"NightElf\",\"class\":\"WARRIOR\",\"name\":\"Beshoe-BleedingHollow\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Beshoe-BleedingHollow receives loot: |cnIQ0:|Hitem:260651::::::::88:1480:::::::::|h[Lustrous Wildlife Pelt]|h|r.\",\"id\":\"s4_2669\",\"timestamp\":1773593761},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: In de winter there were those like de Hoardmonger whose greed burdened others.\",\"id\":\"s4_2670\",\"timestamp\":1773593763},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Babyfat-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Babyfat receives loot: |cnIQ0:|Hitem:260614::::::::88:1480:::::::::|h[Unrecognizable Organ]|h|r.\",\"id\":\"s4_2671\",\"timestamp\":1773593764},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: De Amani hash'ey used their most trusted warriors to eliminate them. For de good of de tribe.\",\"id\":\"s4_2672\",\"timestamp\":1773593770},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Preparin' will help you in de trial ahead.\",\"id\":\"s4_2673\",\"timestamp\":1773593781},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryab