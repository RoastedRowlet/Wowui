",\"name\":\"Hansomee-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Hansomee-Tichondrius receives loot: |cnIQ0:|Hitem:260662::::::::80:1480:::::::::|h[Polished Purple Pebble]|h|r.\",\"id\":\"s2_4863\",\"timestamp\":1773505098},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 33 Gold, 53 Silver, 42 Copper\",\"id\":\"s2_4864\",\"timestamp\":1773505099},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Farewell, old friend...\",\"id\":\"s2_4865\",\"timestamp\":1773505104},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3333|h[Loot]|h: You passed on: |cnIQ2:|Hitem:264338::::::::80:1480::17:::::::|h[Domanaar Control Console]|h|r |HlootHistory:3333|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"id\":\"s2_4866\",\"timestamp\":1773505107},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3333|h[Loot]|h: Mezzyy (Need - 79, Main-Spec) Won: |cnIQ2:|Hitem:264338::::::::80:1480::17:::::::|h[Domanaar Control Console]|h|r\",\"id\":\"s2_4867\",\"timestamp\":1773505108},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"DarkIronDwarf\",\"class\":\"SHAMAN\",\"name\":\"Mezzyy-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Mezzyy receives loot: |cnIQ2:|Hitem:264338::::::::80:1480::17:::::::|h[Domanaar Control Console]|h|r.\",\"id\":\"s2_4868\",\"timestamp\":1773505108},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: I have all I need. Mourn your friend after we save your city.\",\"id\":\"s2_4869\",\"timestamp\":1773505113},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: It's over...\",\"id\":\"s2_4870\",\"timestamp\":1773505121},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Come, through the portal.\",\"id\":\"s2_4871\",\"timestamp\":1773505123},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: The Terrace holds what we require to gain entry to the Voidstorm... the Cynosure of Twilight.\",\"timestamp\":1773505913,\"id\":\"s2_4872\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arcane Sentry\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arcane Sentry yells: Unauthorized entry.\",\"timestamp\":1773505918,\"id\":\"s2_4873\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: You were warned, Umbric! The Terrace is forever closed to you! Now leave before--\",\"timestamp\":1773505981,\"id\":\"s2_4874\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Kalladain-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Kalladain receives loot: |cnIQ0:|Hitem:260662::::::::80:1480:::::::::|h[Polished Purple Pebble]|h|r.\",\"timestamp\":1773505982,\"id\":\"s2_4875\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Monkeymosh-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Monkeymosh receives loot: |cnIQ2:|Hitem:258910::::::::80:1480::133:2:13729:13668:2:9:81:28:3022:::::|h[Tarnished Dawnlit Loop]|h|r.\",\"timestamp\":1773505982,\"id\":\"s2_4876\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Monkeymosh-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Monkeymosh receives loot: |cnIQ0:|Hitem:260662::::::::80:1480:::::::::|h[Polished Purple Pebble]|h|r.\",\"timestamp\":1773505982,\"id\":\"s2_4877\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Of course he left a message for me. I'm afraid you'll have to incapacitate the guards.\",\"timestamp\":1773505987,\"id\":\"s2_4878\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Dwarf\",\"name\":\"Catöflight-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\