078,\"id\":\"s1_3736\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rak'tul\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Rak'tul yells: Souls... no... too many...\",\"timestamp\":1773179078,\"id\":\"s1_3737\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Impuratus-Alleria|h[|cffc41e3aImpuratus-Alleria|r]|h has earned the achievement |cffffff00|Hachievement:61644:Player-52-08B6175C:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Maisara Caverns]|h|r!\",\"timestamp\":1773179078,\"id\":\"s1_3738\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Impuratus-Alleria|h[|cffc41e3aImpuratus-Alleria|r]|h has earned the achievement |cffffff00|Hachievement:61645:Player-52-08B6175C:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Maisara Caverns]|h|r!\",\"timestamp\":1773179078,\"id\":\"s1_3739\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"BloodElf\",\"name\":\"Frostyfae-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Frostyfae-Illidan|h[|cff3fc7ebFrostyfae-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:61639:Player-57-0D38C11A:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Maisara Caverns]|h|r!\",\"timestamp\":1773179078,\"id\":\"s1_3740\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"pl