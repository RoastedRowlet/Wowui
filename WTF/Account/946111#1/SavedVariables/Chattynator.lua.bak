\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 85 Silver, 36 Copper\",\"timestamp\":1773106339,\"id\":\"s1_2574\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 98 Silver, 33 Copper\",\"timestamp\":1773106356,\"id\":\"s1_2575\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:225783::::::::90:102:::::::::|h[Spatial Residue]|h|r\",\"timestamp\":1773106369,\"id\":\"s1_2576\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 92 Silver, 43 Copper\",\"timestamp\":1773106370,\"id\":\"s1_2577\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Aeryndis-Fizzcrank\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Aeryndis-Fizzcrank|h[|cfff48cbaAeryndis-Fizzcrank|r]|h has earned the achievement |cffffff00|Hachievement:61734:Player-106-08ED337F:1:3:9:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Endgame]|h|r!\",\"timestamp\":1773106378,\"id\":\"s1_2578\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Aeryndis-Fizzcrank\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Aeryndis-Fizzcrank|h[|cfff48cbaAeryndis-Fizzcrank|r]|h has earned the achievement |cffffff00|Hachievement:42328:Player-106-08ED337F:1:3:9:26:4294967295:4294967295:4294967295:4294967295|h[One Warband Mentor: Midnight]|h|r!\",\"timestamp\":1773106378,\"id\":\"s1_2579\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue says: We'll meet you out there!\",\"timestamp\":1773106379,\"id\":\"s1_2580\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue says: Hey, Lonelylitten! All you have to do is hit the go button!\",\"timestamp\":1773106394,\"id\":\"s1_2581\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue says: I can't wait to dump all my ore into the bank for you, Crags. I couldn't blacksmith my way out of a paper bag, but that sword you made Arnott is almost as sharp as Rivet!\",\"timestamp\":1773106440,\"id\":\"s1_2582\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Crags\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Crags says: And I'll leave any mail I find in there for you and Kralla, Blue.\",\"timestamp\":1773106449,\"id\":\"s1_2583\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Gadgetzan Bruiser\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Gadgetzan Bruiser says: Hey! Watch where you're portaling!\",\"timestamp\":1773106455,\"id\":\"s1_2584\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: Oh my, that shouldn't be happening!\",\"timestamp\":1773106457,\"id\":\"s1_2585\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: Let me try reversing the positron array...\",\"timestamp\":1773106459,\"id\":\"s1_2586\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Gimblethorn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Gimblethorn says: I'm trying to bank here!\",\"timestamp\":1773106461,\"id\":\"s1_2587\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: Dibs on any cloth! And let me know if anyone needs anything enchanted. I can always use the practice.\",\"timestamp\":1773106461,\"id\":\"s1_2588\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue says: Turns out the real reward was the friends we made along the way! Well, that and the ability to punch holes in space to check our banks from anywhere. But mostly the friends.\",\"timestamp\":1773106465,\"id\":\"s1_2589\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: Hurray! And no one exploded even a little!\",\"timestamp\":1773106466,\"id\":\"s1_2590\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: We don't have to tell anyone about this, right?\",\"timestamp\":1773106468,\"id\":\"s1_2591\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Blue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Blue says: And it turns out that the more people that share a Warband Bank, the faster it recharges. Looks like the magic of friendship is cold hard science! Or something like that, anyway.\",\"timestamp\":1773106474,\"id\":\"s1_2592\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Rivet\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rivet says: That's not how either of those work!\",\"timestamp\":1773106483,\"id\":\"s1_2593\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Kremee-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kremee-Zul'jin|h[|cff00ff98Kremee-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61641:Player-61-0FA79EFE:1:3:9:26:4294967295:4294967295:4294967295:4294967295|h[The Blinding Vale]|h|r!\",\"timestamp\":1773106710,\"id\":\"s1_2594\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Kremee-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kremee-Zul'jin|h[|cff00ff98Kremee-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61649:Player-61-0FA79EFE:1:3:9:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: 