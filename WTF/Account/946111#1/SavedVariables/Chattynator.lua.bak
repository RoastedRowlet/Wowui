\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Lothraxion, this isn't what the Light demands of us.\",\"id\":\"s2_4831\",\"timestamp\":1773504649},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Think of the lives that will be lost--just trust us.\",\"id\":\"s2_4832\",\"timestamp\":1773504652},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You of them all, I thought would understand Arator. \",\"id\":\"s2_4833\",\"timestamp\":1773504656},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: A shame that the Void has corrupted you too.\",\"id\":\"s2_4834\",\"timestamp\":1773504661},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_TARGETICONS\",\"type\":\"TARGETICONS\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Angryabsol|h[Angryabsol]|h sets |TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_6:0|t on Hansomee.\",\"id\":\"s2_4835\",\"timestamp\":1773504665},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Circuit Seer\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Circuit Seer yells: The pylon is showing near critical failure, Chief Corewright!\",\"id\":\"s2_4836\",\"timestamp\":1773504675},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: Hurry up those repairs. If we aren't careful, that will be all of us!\",\"id\":\"s2_4837\",\"timestamp\":1773504678},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"[Tank] |Hplayer:Hansomee|h[Hansomee]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s2_4838\",\"timestamp\":1773504760},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 16 Silver, 85 Copper\",\"id\":\"s2_4839\",\"timestamp\":1773504761},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Hansomee-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Hansomee-Tichondrius receives loot: |cnIQ0:|Hitem:258855::::::::80:1480::17:1:13611:2:9:87:28:3322:::::|h[Stained Armguards]|h|r.\",\"id\":\"s2_4840\",\"timestamp\":1773504794},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kasreth\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kasreth yells: More of you mindless intruders!\",\"id\":\"s2_4841\",\"timestamp\":1773504812},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 14 Gold, 17 Silver, 40 Copper\",\"id\":\"s2_4842\",\"timestamp\":1773504874},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Hansomee-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Hansomee-Tichondrius receives loot: |cnIQ3:|Hitem:251203::::::::80:1480::17:3:13441:13436:13578:2:9:87:28:3022:::::|h[Kasreth's Bindings]|h|r.\",\"id\":\"s2_4843\",\"timestamp\":1773504875},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: You got the last conduit? Make sure to send them over.\",\"id\":\"s2_4844\",\"timestamp\":1773504876},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You will realize I was right, Alleria.\",\"id\":\"s2_4845\",\"timestamp\":1773504885},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: Your judgment has been clouded by the Void. As it always does!\",\"id\":\"s2_4846\",\"timestamp\":1773504889},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: My vision has never been clearer Lothraxion, but I don't want to believe it. \",\"id\":\"s2_4847\",\"timestamp\":1773504894},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Angryabsol|h[Angryabsol]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s2_4848\",\"timestamp\":1773504899},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: The console is working--starting the bridge now!\",\"id\":\"s2_4849\",\"timestamp\":1773504906},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"MONK\",\"name\":\"Sinsual-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Sinsual receives loot: |cnIQ0:|Hitem:260662::::::::80:1480:::::::::|h[Polished Purple Pebble]|h|rx2.\",\"id\":\"s2_4850\",\"timestamp\":1773504991},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"MONK\",\"name\":\"Sinsual-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Sinsual receives loot: |cnIQ1:|Hitem:242639::::::::80:1480:::::::::|h[Practically Pork]|h|rx2.\",\"id\":\"s2_4851\",\"timestamp\":1773504991},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lothraxion yells: You will see.\",\"id\":\"s2_4852\",\"timestamp\":1773505096},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Angryabsol-Stormrage|h[|cffa330c9Angryabsol|r]|h has earned the achievement |cffffff00|Hachievement: