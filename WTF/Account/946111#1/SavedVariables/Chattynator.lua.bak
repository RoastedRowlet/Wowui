mrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: |cnIQ2:|Hitem:264717::::::::86:1480::17:::::::|h[Amani Warding Hex]|h|r\",\"id\":\"s3_4575\",\"timestamp\":1773553411},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 33 Gold, 23 Silver, 69 Copper\",\"id\":\"s3_4576\",\"timestamp\":1773553413},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: With de creature dead an' de Vilebranch gone, we Witherbark all be sleepin' a little safer--for now.\",\"id\":\"s3_4577\",\"timestamp\":1773553416},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: You passed on: |cnIQ2:|Hitem:264717::::::::86:1480::17:::::::|h[Amani Warding Hex]|h|r |HlootHistory:3214|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"id\":\"s3_4578\",\"timestamp\":1773553418},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: Orcanea (Need - 98, Main-Spec) Won: |cnIQ2:|Hitem:264717::::::::86:1480::17:::::::|h[Amani Warding Hex]|h|r\",\"id\":\"s3_4579\",\"timestamp\":1773553418},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ2:|Hitem:264717::::::::86:1480::17:::::::|h[Amani Warding Hex]|h|r.\",\"id\":\"s3_4580\",\"timestamp\":1773553418},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Heelie-Aegwynn\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Heelie-Aegwynn receives loot: |cnIQ3:|Hitem:250258::::::::86:1480::1:3:13442:13437:6652:1:28:3022:::::|h[Vessel of Tortured Souls]|h|r.\",\"id\":\"s3_4581\",\"timestamp\":1773553420},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Heathcliff-Haomarush\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Heathcliff-Haomarush receives loot: |cnIQ3:|Hitem:251164::::::::86:1480::1:4:13442:13437:6652:13578:1:28:5071:::::|h[Amalgamation's Harness]|h|r.\",\"id\":\"s3_4582\",\"timestamp\":1773553423},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: We will always be lookin' over our shoulders at de Vilebranch. Come back with me. De chief be havin' a reward for ya.\",\"id\":\"s3_4583\",\"timestamp\":1773553426},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Alas, if I had but one worthy customer...\",\"id\":\"s3_4584\",\"timestamp\":1773553449},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"id\":\"s3_4585\",\"timestamp\":1773553472},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"id\":\"s3_4586\",\"timestamp\":1773553478},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_TARGETICONS\",\"type\":\"TARGETICONS\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Angryabsol|h[Angryabsol]|h sets |TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_6:0|t on Orcanea.\",\"id\":\"s3_4587\",\"timestamp\":1773553481},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"id\":\"s3_4588\",\"timestamp\":1773553484},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ3:|Hitem:258929::::::::86:1480::134:3:13730:6652:13578:2:9:84:28:3022:::::|h[Tarnished Dawnlit Sentinel's Sabatons]|h|r.\",\"id\":\"s3_4589\",\"timestamp\":1773553532},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ0:|Hitem:260638::::::::86:1480:::::::::|h[Fine Void Residue]|h|r.\",\"id\":\"s3_4590\