olor\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s0_776\",\"timestamp\":1772733812},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:236776::::::::85:1473::::1:38:13:::::|h[Argentleaf |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2\",\"id\":\"s0_777\",\"timestamp\":1772733821},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Messenger Aelor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Messenger Aelor says: Hello? Barelynoer? Can you hear me? I bring a message from Magister Umbric!\",\"id\":\"s0_778\",\"timestamp\":1772733864},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Trading Post Barker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Trading Post Barker says: Hey friend! Come check out our new items in the Trading Post. We just got a new shipment!\",\"id\":\"s0_779\",\"timestamp\":1772733889},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: Well met, Zen'kala. I am looking to acquire a particularly rare item.\",\"id\":\"s0_780\",\"timestamp\":1772733904},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: It's strangely comforting...\",\"id\":\"s0_781\",\"timestamp\":1772733908},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Darkmoon Faire Greeter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Darkmoon Faire Greeter says: Welcome to the Darkmoon Faire, evoker!\",\"id\":\"s0_782\",\"timestamp\":1772733946},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Barelynoer-Area52|h[|cff33937fBarelynoer|r]|h has earned the achievement |cffffff00|Hachievement:6019:Player-3676-0DF7D3EF:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Come One, Come All!]|h|r!\",\"id\":\"s0_783\",\"timestamp\":1772733949},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Barelynoer-Area52|h[|cff33937fBarelynoer|r]|h has earned the achievement |cffffff00|Hachievement:6019:Player-3676-0DF7D3EF:1:3:5:26:4294967295:4294967295:4294967295:4294967295|h[Come One, Come All!]|h|r!\",\"id\":\"s0_784\",\"timestamp\":1772733949},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"\\\"Dusty\\\" Brandom\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"\\\"Dusty\\\" Brandom says: Welcome to Darkmoon Island! Feel free to ride one of these lovely beasts down to the Faire.\",\"id\":\"s0_785\",\"timestamp\":1772733952},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zina Sharpworth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zina Sharpworth says: Hurry, hurry, hurry! Step right up and purchase your game tokens!\",\"id\":\"s0_786\",\"timestamp\":1772733984},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"b\":1,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Barelynoer-Area52:4069:SAY:|h[|cff33937fBarelynoer|r]|h says: 47.2 64.847.4 64.247.8 65.648.0 64.448.0 64.8\",\"id\":\"s0_787\",\"timestamp\":1772733993},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Mola\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Mola says: Whack some gnolls! Step right up and whack some gnolls!\",\"id\":\"s0_788\",\"timestamp\":1772733994},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Poot\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Poot says: I wonder how often the sandbox gets cleaned.\",\"id\":\"s0_789\",\"timestamp\":1772734001},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|cnNORMAL_FONT_COLOR:Lonelylitten|r |cnHIGHLIGHT_FONT_COLOR:transferred |cnIQ1:|Hcurrency:515:9|h[Darkmoon Prize Ticket]|h|rx9 to|r |cnNORMAL_FONT_COLOR:Barelynoer.|r\",\"id\":\"s0_790\",\"timestamp\":1772734045},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:515:0|h[Darkmoon Prize Ticket]|h|rx9\",\"id\":\"s0_791\",\"timestamp\":1772734046},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Rinling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Rinling says: Guns, guns, guns! C'mon, pal!\",\"id\":\"s0_792\",\"timestamp\":1772734055},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kae Ti\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kae Ti says: Ride tickets! Purchase a book of ride tickets here!\",\"id\":\"s0_793\",\"timestamp\":1772734060},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:92794::::::::85:1473::14::1:28:402:::::|h[Ride Ticket Book]|h|r\",\"id\":\"s0_794\",\"timestamp\":1772734062},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kae Ti\"},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"You need a Darkmoon Ride Ticket to use the carousel.\",\"id\":\"s0_795\",\"timestamp\":1772734064},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Dis must be de fire Lilaju spoke of.\",\"id\":\"s0_796\",\"timestamp\":1772734074},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.\",\"id\":\"s0_797\",\"timestamp\":1772734077},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.\",\"id\":\"s0_798\",\"timestamp\":1772734090},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.\",\"id\":\"s0_799\",\"timestamp\":1772734101},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.\",\"id\":\"s0_800\",\"timestamp\":1772734111},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Siber|h[Siber]: |h|A:ping_chat_threat:0:0:0:0|aThreatening alert: Starvation Effigy\",\"id\":\"s0_801\",\"timestamp\":1772734163},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Siber|h[Siber]: |h|A:ping_chat_threat:0:0:0:0|aThreatening alert: Starvation Effigy\",\"id\":\"s0_802\",\"timestamp\":1772734175},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Pubofthehorn-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"col