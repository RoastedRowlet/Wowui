",\"timestamp\":1773985884},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 10 Gold, 63 Silver, 2 Copper\",\"id\":\"s6_3602\",\"timestamp\":1773985890},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Professor Maxdormu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Professor Maxdormu says: Since you did so well on your lesson, feel free to take something from the 'Good Students' Reward Chest.\",\"id\":\"s6_3603\",\"timestamp\":1773985892},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"EarthenDwarf\",\"class\":\"WARLOCK\",\"name\":\"Demonpotato-Korgath\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Demonpotato-Korgath receives loot: |cnIQ4:|Hitem:193710::::::::90:1480::23:4:12785:13439:43:12701:1:28:2587:::::|h[Spellboon Saber]|h|r.\",\"id\":\"s6_3604\",\"timestamp\":1773985893},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"EarthenDwarf\",\"class\":\"WARLOCK\",\"name\":\"Demonpotato-Korgath\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Demonpotato-Korgath receives loot: |cnIQ0:|Hitem:192624::::::::90:1480:::::::::|h[Cracked Scales]|h|r.\",\"id\":\"s6_3605\",\"timestamp\":1773985923},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Kojapa-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Kojapa-Kel'Thuzad receives loot: |cnIQ0:|Hitem:192624::::::::90:1480:::::::::|h[Cracked Scales]|h|rx2.\",\"id\":\"s6_3606\",\"timestamp\":1773985924},{\"recordedBy\":\"Angryabsol-Stormrage\",\"type