xt\":\"Zulclaw-Tichondrius receives loot: |cnIQ0:|Hitem:260614::::::::86:1473:::::::::|h[Unrecognizable Organ]|h|r.\",\"id\":\"s0_1547\",\"timestamp\":1772754876},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Zulclaw-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Zulclaw-Tichondrius receives loot: |cnIQ3:|Hitem:251166::::::::86:1473::17:3:13441:13436:13578:2:9:88:28:3022:::::|h[Falconer's Cinch]|h|r.\",\"id\":\"s0_1548\",\"timestamp\":1772755003},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 16 Gold, 30 Silver, 25 Copper\",\"id\":\"s0_1549\",\"timestamp\":1772755003},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: A good kill, Barelynoer. And I rescued all that were still alive. But why did Muro'jin bring them here?\",\"id\":\"s0_1550\",\"timestamp\":1772755004},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: De kidnapping won't stop until we get to de root of de evil. Follow me.\",\"id\":\"s0_1551\",\"timestamp\":1772755012},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Rokh'zal\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Rokh'zal yells: You cannot stop de ritual! Spirits, rise!\",\"id\":\"s0_1552\",\"timestamp\":1772755026},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: That... not be natural. And the energy flowing into it... This is hex magic.\",\"id\":\"s0_1553\",\"timestamp\":1772755026},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: Using the souls of de dead in powerful magic spells... I hope this is not why they brought my kin here.\",\"id\":\"s0_1554\",\"timestamp\":1772755033},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Lalapriest|h[Lalapriest]: |h|A:ping_chat_threat:0:0:0:0|aThreatening alert: Rokh'zal\",\"id\":\"s0_1555\",\"timestamp\":1772755037},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Rokh'zal\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"|TInterface\\\\ICONS\\\\Spell_Shadow_RitualOfSacrifice.blp:20|t Rokh'zal prepares Barelynoer for |cFFFF0000|Hspell:1259786|h[Ritual Sacrifice]|h|r!\",\"id\":\"s0_1556\",\"timestamp\":1772755063},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Tiêrney-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Tiêrney receives loot: |cnIQ0:|Hitem:260614::::::::86:1473:::::::::|h[Unrecognizable Organ]|h|r.\",\"id\":\"s0_1557\",\"timestamp\":1772755119},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PRIEST\",\"name\":\"Lalapriest-Area