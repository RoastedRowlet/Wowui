\",\"typeInfo\":{\"event\":\"CHAT_MSG_TARGETICONS\",\"type\":\"TARGETICONS\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Driftkiing|h[Driftkiing]|h sets |TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_4:0|t on Darthryan.\",\"id\":\"s5_4856\",\"timestamp\":1773890661},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The Ranger-General was sharp and steadfast, while the peacekeeper kept the calm. Which path will you choose?\",\"id\":\"s5_4857\",\"timestamp\":1773890683},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Randomremix-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_YELL\",\"type\":\"YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"|Hplayer:Randomremix-Mal'Ganis:2157:YELL:|h[|cffa330c9Randomremix-Mal'Ganis|r]|h yells: HEE HEE!\",\"id\":\"s5_4858\",\"timestamp\":1773890687},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Randomremix-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_YELL\",\"type\":\"YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"|Hplayer:Randomremix-Mal'Ganis:2158:YELL:|h[|cffa330c9Randomremix-Mal'Ganis|r]|h yells: Darkness DOWN! \",\"id\":\"s5_4859\",\"timestamp\":1773890700},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Randomremix-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_YELL\",\"type\":\"YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"|Hplayer:Randomremix-Mal'Ganis:2159:YELL:|h[|cffa330c9Randomremix-Mal'Ganis|r]|h yells: HEE HEE!\",\"id\":\"s5_4860\",\"timestamp\":1773890705},{\"record