"|Hchannel:PARTY|h[Party]|h |Hplayer:Barelynoer-Area52:526:PARTY:|h[|cff33937fBarelynoer|r]|h: ggs all!\",\"id\":\"s2_3350\",\"timestamp\":1773336909},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARRIOR\",\"name\":\"Rakno-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Rakno-Tichondrius:527:PARTY:|h[|cffc69b6dRakno-Tichondrius|r]|h: Ah gotcha I just need the void places\",\"id\":\"s2_3351\",\"timestamp\":1773336910},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARRIOR\",\"name\":\"Rakno-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Rakno-Tichondrius:528:PARTY:|h[|cffc69b6dRakno-Tichondrius|r]|h: locked to rest\",\"id\":\"s2_3352\",\"timestamp\":1773336912},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Syramónk-Thrall\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Syramónk-Thrall:38:PARTY:|h[|cff00ff98Syramónk-Thrall|r]|h: ayo\",\"id\":\"s2_3353\",\"timestamp\":1773342292},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"DEATHKNIGHT\",\"name\":\"Typhonnis-Proudmoore\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Typhonnis-Proudmoore:39:PARTY:|h[|cffc41e3aTyphonnis-Proudmoore|r]|h: hey hey\",\"id\":\"s2_3354\",\"timestamp\":1773342294},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Barelynoer-Area52:44:PARTY:|h[|cff33937fBarelynoer|r]|h: hey!\",\"id\":\"s2_3355\",\"timestamp\":1773342300},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:45:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: omw\",\"id\":\"s2_3356\",\"timestamp\":1773342335},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:46:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: ty\",\"id\":\"s2_3357\",\"timestamp\":1773342335},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_TARGETICONS\",\"type\":\"TARGETICONS\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Syramónk|h[Syramónk]|h sets |TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_6:0|t on Syramónk.\",\"id\":\"s2_3358\",\"timestamp\":1773342394},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: My sisters were the last to visit these halls, but they threw their home and their bond away. If we can calm the spirits here, maybe they'll return.\",\"id\":\"s2_3359\",\"timestamp\":1773342398},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The Ranger-General was sharp and steadfast, while the peacekeeper kept the calm. Which path will you choose?\",\"id\":\"s2_3360\",\"timestamp\":1773342410},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas didn't ask to be Ranger-General, but she gave everything to the task... including her life.\",\"id\":\"s2_3361\",\"timestamp\":1773342479},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: She trained with a bow gifted by our mother. Undead fanatics have invaded to loot it, and anything else that belonged to her.\",\"id\":\"s2_3362\",\"timestamp\":1773342517},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"DEATHKNIGHT\",\"name\":\"Typhonnis-Proudmoore\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Typhonnis-Proudmoore receives loot: |cnIQ0:|Hitem:260660::::::::90:1473:::::::::|h[Putrid Mushroom Spores]|h|rx3.\",\"id\":\"s2_3363\",\"timestamp\":1773342634},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Our mother's bow meant everything to Sylvanas, once. I'll need it.\",\"id\":\"s2_3364\",\"timestamp\":1773342647},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"DEATHKNIGHT\",\"name\":\"Typhonnis-Proudmoore\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Typhonnis-Proudmoore receives loot: |cnIQ0:|Hitem:260660::::::::90:1473:::::::::|h[Putrid Mushroom Spores]|h|r.\",\"id\":\"s2_3365\",\"timestamp\":1773342671},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Latch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Latch yells: Latch... sorry...\",\"id\":\"s2_3366\",\"timestamp\":1773342735},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:251083::::::::90:1473::23:4:12779:13439:6652:12701:1:28:3025:::::|h[Excavating Cudgel]|h|r\",\"id\":\"s2_3367\",\"timestamp\":1773342738},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 13 Gold, 24 Silver, 7 Copper\",\"id\":\"s2_3368\",\"timestamp\":1773342738},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas was sometimes vain, and loved to be admired, but she never wanted to be worshipped.\",\"id\":\"s2_3369\",\"timestamp\":1773342740},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, let's find the next relic.\",\"id\":\"s2_3370\",\"timestamp\":1773342748},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:76:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: yall doing anymore\",\"id\":\"s2_3371\",\"timestamp\":1773342754},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Syramónk-Thrall\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Syramónk-Thrall:77:PARTY:|h[|cff00ff98Syramónk-Thrall|r]|h: i am\",\"id\":\"s2_3372\",\"timestamp\":1773342762},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Ingro-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Ingro-BleedingHollow:78:PARTY:|h[|cffa330c9Ingro-BleedingHollow|r]|h: inv after\",\"id\":\"s2_3373\",\"timestamp\":1773342767},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Vereesa was the peacekeeper of our family. She spent many days tending to the gardens here, but the wilderness has overtaken it now.\",\"id\":\"s2_3374\",\"timestamp\":1773342798},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The soothing sounds of my harp brought Vereesa joy beyond measure. I'll need that relic.\",\"id\":\"s2_3375\",\"timestamp\":1773342902},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"id\":\"s2_3376\",\"timestamp\":1773342957},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Beautiful! She reminds me of Vereesa. My sister was also ferocity itself if her family was threatened.\",\"id\":\"s2_3377\",\"timestamp\":1773343022},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Syramónk-Thrall\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Syramónk-Thrall receives loot: |cnIQ4:|Hitem:250144::::::::90:1473::23:4:12779:13439:6652:12699:1:28:3022:::::|h[Emberwing Feather]|h|r.\",\"id\":\"s2_3378\",\"timestamp\":1773343024},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 13 Gold, 24 Silver, 23 Copper\",\"id\":\"s2_3379\",\"timestamp\":1773343028},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, we have one more relic to find.\",\"id\":\"s2_3380\",\"timestamp\":1773343031},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Alleria hunted the Old Horde with a ferocity bordering on obsession.\",\"id\":\"s2_3381\",\"timestamp\":1773343092},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: For good reason--they took my life, savaged our home.\",\"id\":\"s2_3382\",\"timestamp\":1773343099},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: One of Alleria's scouting maps is within. It seems to have called on the ghosts of vengeance past. We'll need that map from them.\",\"id\":\"s2_3383\",\"timestamp\":1773343106},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Syramónk-Thrall\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Syramónk-Thrall receives loot: |cnIQ0:|Hitem:260651::::::::90:1473:::::::::|h[Lustrous Wildlife Pelt]|h|r.\",\"id\":\"s2_3384\",\"timestamp\":1773343164},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::90:1473:::::::::|h[Putrid Mushroom Spores]|h|rx3\",\"id\":\"s2_3385\",\"timestamp\":1773343166},{\"recordedBy\":\