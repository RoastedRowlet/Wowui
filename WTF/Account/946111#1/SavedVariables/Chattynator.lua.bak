{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Alleria Windrunner",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Alleria Windrunner says: I sense great despair emanating from within. L'ura...",
["id"] = "s7_3318",
["timestamp"] = 1774144668,
},
{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Locus-Walker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Locus-Walker says: Yes, the naaru. We must get inside. Alleria, the skills you have learned can open the way.",
["id"] = "s7_3319",
["timestamp"] = 1774144678,
},
{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Alleria Windrunner",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Alleria Windrunner says: Such chaos... such anguish. I have never sensed anything like it before.",
["id"] = "s7_3320",
["timestamp"] = 1774144690,
},
{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Alleria Windrunner",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Alleria Windrunner says: The way is open! Hurry, heroes!",
["id"] = "s7_3321",
["timestamp"] = 1774144692,
},
{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Locus-Walker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Locus-Walker says: It is rare that a naaru falls into Void this way. The few cases I know of have occurred when mortals were involved. What fascinating implications...",
["id"] = "s7_3322",
["timestamp"] = 1774144698,
},
{
["recordedBy"] = "Angryabsol-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Locus-Walker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Locus-Walker says: Such musings can wait, though. This entity must die.",
["id"] = "s7_3323",
["timestamp"] = 1774144712,
},
