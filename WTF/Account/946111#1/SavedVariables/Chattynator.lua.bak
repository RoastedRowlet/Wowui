},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: A good kill, Lonelylitten. And I rescued all that were still alive. But why did Muro'jin bring them here?",
["timestamp"] = 1774330368,
["id"] = "s7_4955",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: De kidnapping won't stop until we get to de root of de evil. Follow me.",
["timestamp"] = 1774330376,
["id"] = "s7_4956",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Rokh'zal",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Rokh'zal yells: You cannot stop de ritual! Spirits, rise!",
["timestamp"] = 1774330389,
["id"] = "s7_4957",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: That... not be natural. And the energy flowing into it... This is hex magic.",
["timestamp"] = 1774330389,
["id"] = "s7_4958",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: Using the souls of de dead in powerful magic spells... I hope this is not why they brought my kin here.",
["timestamp"] = 1774330397,
["id"] = "s7_4959",
},
