},
["text"] = "Kojapa-Kel'Thuzad receives loot: |cnIQ4:|Hitem:251176::::::::90:105::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Reanimator's Weight]|h|r.",
["timestamp"] = 1774330366,
