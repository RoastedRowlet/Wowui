yer\":{\"race\":\"Draenei\",\"class\":\"PALADIN\",\"name\":\"Leïïrbag-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_WHISPER_INFORM\",\"type\":\"WHISPER\"},\"color\":{\"b\":1,\"g\":0.501960813999176,\"r\":1},\"text\":\"To |Hplayer:Leïïrbag-Stormrage:1187:WHISPER:LEÏÏRBAG-STORMRAGE|h[|cfff48cbaLeïïrbag|r]|h: I can!\",\"id\":\"s1_3055\",\"timestamp\":1773160131},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"PALADIN\",\"name\":\"Girthshaker-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Girthshaker-Kel'Thuzad|h[|cfff48cbaGirthshaker-Kel'Thuzad|r]|h has earned the achievement |cffffff00|Hachievement:61724:Player-3693-0E1D2D23:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[The Grudge Pit Stories]|h|r!\",\"id\":\"s1_3056\",\"timestamp\":1773160240},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:1439:GUILD:|h[|cff0070ddDaí|r]|h: have you guys found the weekly pick 1/4 activity quest?\",\"id\":\"s1_3057\",\"timestamp\":1773160276},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"PALADIN\",\"name\":\"Girthshaker-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Girthshaker-Kel'Thuzad:1440:GUILD:|h[|cfff48cbaGirthshaker|r]|h: Where is Parhelion Plaza and The Darkway? Are those able to be done atm?\",\"id\":\"s1_3058\",\"timestamp\":1773160276},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"PALADIN\",\"name\":\"Girthshaker-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Girthshaker-Kel'Thuzad:1461:GUILD:|h[|cfff48cbaGirthshaker|r]|h: It's beside the Bank Dai, bottom of the stairs to the right from the inn\",\"id\":\"s1_3059\",\"timestamp\":1773160297},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:1486:GUILD:|h[|cff0070ddDaí|r]|h: and i dont think those delves are in game yet\",\"id\":\"s1_3060\",\"timestamp\":1773160322},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Bumlock-BleedingHollow:1502:GUILD:|h[|cff8788eeBumlock|r]|h: so is there any reason to do this pvp quest? 4 weeks no ones gonna need that ring\",\"id\":\"s1_3061\",\"timestamp\":1773160358},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:1513:GUILD:|h[|cff0070ddDaí|r]|h: huh I have the pvp quest and the renown qust\",\"id\":\"s1_3062\",\"timestamp\":1773160393},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:1514:GUILD:|h[|cff0070ddDaí|r]|h: quest\",\"id\":\"s1_3063\",\"timestamp\":1773160396},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Daí-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Daí-Zul'jin:1515:GUILD:|h[|cff0070ddDaí|r]|h: but she has nothing for me\",\"id\":\"s1_3064\",\"timestamp\":1773160399},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Bumlock-BleedingHollow:1523:GUILD:|h[|cff8788eeBumlock|r]|h: |cffffff00|Hquest:94835:3313|h[Early Morning Training]|h|r\",\"id\":\"s1_3065\",\"timestamp\":1773160409},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Lonelylitten-Stormrage:1529:GUILD:|h[|cffff7c0aLonelylitten|r]|h: yeah i also have those two, no spark quest?\",\"id\":\"s1_3066\",\"timestamp\":1773160426},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Bumlock-BleedingHollow:1558:GUILD:|h[|cff8788eeBumlock|r]|h: not that ive seen\",\"id\":\"s1_3067\",\"timestamp\":1773160487},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: I have received word from Magister Umbric. The way to the Voidstorm is clear!\",\"id\":\"s1_3068\",\"timestamp\":1773160508},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: I sent Lady Liadrin to inform the Vanguard's commanders that they may deploy at once, and leave our city in peace.\",\"id\":\"s1_3069\",\"timestamp\":1773160514},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Nikeshoes-Zul'jin\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Nikeshoes-Zul'jin|h[|cffff7c0aNikeshoes-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:62137:Player-61-0FD2A743:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[I'm Not Trapped In Here With You]|h|r!\",\"id\":\"s1_3070\",\"timestamp\":1773160530},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Your redeployment leaves a scant few behind to empower the Sunwell!\",\"id\":\"s1_3071\",\"timestamp\":1773160566},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Would you check in with the Vanguard commanders for me, Lonelylitten? I must explain to the general why the Sunwell must not fall.\",\"id\":\"s1_3072\",\"timestamp\":1773160584},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Bumlock-BleedingHollow:1599:GUILD:|h[|cff8788eeBumlock|r]|h: also do we need vantus runes yet? I can start making those I just need petrified root\",\"id\":\"s1_3073\",\"timestamp\":1773160588},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: You think too provincially. We need the full might of the Vanguard to defeat Xal'atath.\",\"id\":\"s1_3074\",\"timestamp\":1773160593},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Venel Lightblood\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Venel Lightblood says: Prepare yourself, druid.\",\"id\":\"s1_3075\",\"timestamp\":1773160595},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"War Chaplain Senn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"War Chaplain Senn says: You are a beacon in the darkness. We will succeed, no matter the cost.\",\"id\":\"s1_3076\",\"timestamp\":1773160625},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: Get those modifications fitted or we'll suffocate! The air on the other side is thicker than me gran's lamb stew.\",\"id\":\"s1_3077\",\"timestamp\":1773160636},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: My gran taught me to fight the good fight, even if it seems hopeless, and to put me faith in the Light.\",\"id\":\"s1_3078\",\"timestamp\":1773160637},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: We have left you a token force to hold back the Voidstorm. Light willing, it will suffice.\",\"id\":\"s1_3079\",\"timestamp\":1773160644},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: Though, two tons of Light-blessed steel warframe bolsters my courage.\",\"id\":\"s1_3080\",\"timestamp\":1773160646},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: We both claim the Light as our guide, but yours is a sterile, cold faith I scarcely recognize.\",\"id\":\"s1_3081\",\"timestamp\":1773160651},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: We can't spare the troops! Those ethereal cannons have us pinned down.\",\"id\":\"s1_3082\",\"timestamp\":1773160668},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: We're being hit from all sides! We need a tactical assessment. Umbric! Lonelylitten can assist you.\",\"id\":\"s1_3083\",\"timestamp\":1773160670},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: With this device, you'll be able to view the tactical situation in relative safety.\",\"id\":\"s1_3084\",\"timestamp\":1773160678},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: The captured ren'dorei are links in a chain. Break that chain, and our assault can truly begin.\",\"id\":\"s1_3085\",\"timestamp\":1773160733},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: You're right, Umbric. Freeing your people gives us the opening we need for an assault.\",\"id\":\"s1_3086\",\"timestamp\":1773160743},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: The Void enslaves you, while I am empowered by it!\",\"id\":\"s1_3087\",\"timestamp\":1773160782},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260615::::::::90:102:::::::::|h[Void Dust Residue]|h|r\",\"id\":\"s1_3088\",\"timestamp\":1773160791},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 6 Gold, 15 Silver, 32 Copper\",\"id\":\"s1_3089\",\"timestamp\":1773160792},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Darkglen says: The Voidspire will fall, ethereals!\",\"id\":\"s1_3090\",\"timestamp\":1773160802},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 1 Gold, 86 Silver, 87 Copper\",\"id\":\"s1_3091\",\"timestamp\":1773160808},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Kelain\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Kelain says: Here! Take this message back to Xal'atath!\",\"id\":\"s1_3092\",\"timestamp\":1773160821},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 2 Gold, 62 Silver, 78 Copper\",\"id\":\"s1_3093\",\"timestamp\":1773160866},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260650::::::::90:102:::::::::|h[Elemental Debris]|h|r\",\"id\":\"s1_3094\",\"timestamp\":1773160890},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 61 Silver, 70 Copper\",\"id\":\"s1_3095\",\"timestamp\":1773160891},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Well done, Lonelylitten! You've struck a decisive blow against the Devouring Host. With Umbric's help.\",\"id\":\"s1_3096\",\"timestamp\":1773160898},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257179::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Mantle]|h|r\",\"id\":\"s1_3097\",\"timestamp\":1773160901},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257166::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Shroud]|h|r\",\"id\":\"s1_3098\",\"timestamp\":1773160902},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Lonelylitten, report to Commander Mountainfist. We'd be honored if you would join the Warframe assault.\",\"id\":\"s1_3099\",\"timestamp\":1773160905},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: The Void cannons had us squattin' in a ditch since we got here. Seems only fair we return the favor. Care to give it a go?\",\"id\":\"s1_3100\",\"timestamp\":1773160909},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: I can see why the Light called you to this fight. You're an inspiration to all of us fighting the Void.\",\"id\":\"s1_3101\",\"timestamp\":1773160976},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257188::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Wristwraps]|h|r\",\"id\":\"s1_3102\",\"timestamp\":1773160981},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:262610::::::::90:102::11::1:28:3320:::::|h[Swirling Ritual Pedestal]|h|r\",\"id\":\"s1_3103\",\"timestamp\":1773160981},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Check in with Arator if you haven't had a chance yet. He's over on the other side of camp, tending to the wounded.\",\"id\":\"s1_3104\",\"timestamp\":1773160982},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Oh, Lonelylitten. You're here. Good. I need your help.\",\"id\":\"s1_3105\",\"timestamp\":1773160990},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: The Vanguard has rushed out full of conviction, and its soldiers return here to the infirmary.\",\"id\":\"s1_3106\",\"timestamp\":1773160997},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: We need to get out there and help those still on the battlefield.\",\"id\":\"s1_3107\",\"timestamp\":1773161006},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Vanguard Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vanguard Scout says: Moving out! Light bless you!\",\"id\":\"s1_3108\",\"timestamp\":1773161034},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: May the Light bless the fallen and safeguard the living as we hold back this evil from our world.\",\"id\":\"s1_3109\",\"timestamp\":1773161048},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3110\",\"timestamp\":1773161050},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3111\",\"timestamp\":1773161058},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: All these poor souls were peeled off from their units. We should stay together.\",\"id\":\"s1_3112\",\"timestamp\":1773161066},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3113\",\"timestamp\":1773161067},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Heal within the protection of my Light! We will defend you!\",\"id\":\"s1_3114\",\"timestamp\":1773161072},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Vanguard Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vanguard Scout says: We would have died if not for you!\",\"id\":\"s1_3115\",\"timestamp\":1773161089},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3116\",\"timestamp\":1773161094},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: If I've learned anything from this place, it's that the Devouring Host is eager to prey upon our convictions.\",\"id\":\"s1_3117\",\"timestamp\":1773161098},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3118\",\"timestamp\":1773161099},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3119\",\"timestamp\":1773161111},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Vanguard Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vanguard Scout says: Thank you! We'll regroup for the next assault.\",\"id\":\"s1_3120\",\"timestamp\":1773161120},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3121\",\"timestamp\":1773161123},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:102:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s1_3122\",\"timestamp\":1773161132},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257210::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Pants]|h|r\",\"id\":\"s1_3123\",\"timestamp\":1773161133},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257207::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Cord]|h|r\",\"id\":\"s1_3124\",\"timestamp\":1773161134},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Thank you for all you've done, Lonelylitten. For the Vanguard, for Silvermoon... and for me.\",\"id\":\"s1_3125\",\"timestamp\":1773161134},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Bumlock-BleedingHollow|h[|cff8788eeBumlock-BleedingHollow|r]|h has earned the achievement |cffffff00|Hachievement:61438:Player-73-072CF71C:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Thalassian Profession Master]|h|r!\",\"id\":\"s1_3126\",\"timestamp\":1773161142},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Bumlock-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Bumlock-BleedingHollow|h[|cff8788eeBumlock-BleedingHollow|r]|h has earned the achievement |cffffff00|Hachievement:42796:Player-73-072CF71C:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Inscribing at Midnight]|h|r!\",\"id\":\"s1_3127\",\"timestamp\":1773161142},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"War Chaplain Senn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"War Chaplain Senn says: Champion! Alleria had scarcely arrived before she left to track down our missing officers.\",\"id\":\"s1_3128\",\"timestamp\":1773161163},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"KulTiran\",\"class\":\"DRUID\",\"name\":\"Themid-Zul'jin\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Themid-Zul'jin|h[|cffff7c0aThemid-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61922:Player-61-0F288638:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Ninety Percent is Good Enough]|h|r!\",\"id\":\"s1_3129\",\"timestamp\":1773161166},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Lonelylitten, a word. I ask that you not mention anything to my mother about what happened at the Amani Pass.\",\"id\":\"s1_3130\",\"timestamp\":1773161175},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s1_3131\",\"timestamp\":1773161184},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: I assume Arator sent you to help me? I could use another pair of hands.\",\"id\":\"s1_3132\",\"timestamp\":1773161189},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Scraps of a Vanguard uniform... officer emblem... just as I thought.\",\"id\":\"s1_3133\",\"timestamp\":1773161194},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: They're abducting the Vanguard's officers, Lonelylitten. Is this just the hunger of the beasts, or is Xal'atath gathering intelligence?\",\"id\":\"s1_3134\",\"timestamp\":1773161203},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Stay alert, Lonelylitten. These creatures can come from anywhere.\",\"id\":\"s1_3135\",\"timestamp\":1773161219},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This was one of the soldiers from the Vanguard. They must've been dragged from their cot, then feasted upon here in the gorge.\",\"id\":\"s1_3136\",\"timestamp\":1773161225},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This body is half-eaten, torn apart by those scavengers.\",\"id\":\"s1_3137\",\"timestamp\":1773161240},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This blood is fresh... wait, Lonelylitten. Do you hear that?\",\"id\":\"s1_3138\",\"timestamp\":1773161249},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Oh no. Not another portal!\",\"id\":\"s1_3139\",\"timestamp\":1773161254},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: By the Light--get off me, you beast!\",\"id\":\"s1_3140\",\"timestamp\":1773161255},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: A survivor! We're not too late!\",\"id\":\"s1_3141\",\"timestamp\":1773161259},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Hello? Is anyone there? I need help!\",\"id\":\"s1_3142\",\"timestamp\":1773161270},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257216::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Striders]|h|r\",\"id\":\"s1_3143\",\"timestamp\":1773161272},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: You're not with the Vanguard. Not that I mind the rescue. Who was that woman you were with?\",\"id\":\"s1_3144\",\"timestamp\":1773161280},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Was that the High Exarch's wife? I mean girlfriend. I thought she'd be taller. Is it true she has a dark naaru for a heart?\",\"id\":\"s1_3145\",\"timestamp\":1773161287},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: That's the big bastard that brought me here.\",\"id\":\"s1_3146\",\"timestamp\":1773161296},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Time to light 'im up!\",\"id\":\"s1_3147\",\"timestamp\":1773161299},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::90:102:::::::::|h[Practically Pork]|h|rx2\",\"id\":\"s1_3148\",\"timestamp\":1773161310},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260647::::::::90:102:::::::::|h[Digested Human Hand]|h|r\",\"id\":\"s1_3149\",\"timestamp\":1773161310},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Lonelylitten, you made it. And you managed to rescue the officer.\",\"id\":\"s1_3150\",\"timestamp\":1773161318},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Oh my Light, it really IS you! This. Is. Ah-may-zing!\",\"id\":\"s1_3151\",\"timestamp\":1773161323},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257202::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Grasps]|h|r\",\"id\":\"s1_3152\",\"timestamp\":1773161331},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: With the beasts slain, I can get back to camp on my own.\",\"id\":\"s1_3153\",\"timestamp\":1773161332},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s1_3154\",\"timestamp\":1773161338},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Stand fast. The Void's hunger must not claim any more of our people.\",\"id\":\"s1_3155\",\"timestamp\":1773161338},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: You struck down our son?\",\"id\":\"s1_3156\",\"timestamp\":1773161351},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: It was an accident. A terrible accident. Seeing Arator wounded like that...\",\"id\":\"s1_3157\",\"timestamp\":1773161354},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Thank the Light he survived. He has forgiven me for it, and we have put it behind us.\",\"id\":\"s1_3158\",\"timestamp\":1773161362},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: No! What has happened to you? How could you attack Arator?\",\"id\":\"s1_3159\",\"timestamp\":1773161369},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: It wasn't Arator I was attacking. He leapt in front of a blow meant for a sworn enemy.\",\"id\":\"s1_3160\",\"timestamp\":1773161374},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: I still don't know what possessed him to do it. But I did not seek to harm our son. I was acting in service of the Light.\",\"id\":\"s1_3161\",\"timestamp\":1773161380},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: I am often reminded, mostly by people who serve the Light, of the danger I represent.\",\"id\":\"s1_3162\",\"timestamp\":1773161390},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: The Void screams at me to do horrible things. I suppress it, because I could never bear to hurt Arator.\",\"id\":\"s1_3163\",\"timestamp\":1773161397},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: But you, in your Light-blind wrath, struck him down! You gave yourself to the Light, and our son was the casualty!\",\"id\":\"s1_3164\",\"timestamp\":1773161405},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: What happened at the Amani Pass was my failing, not the Light's. I will not renounce it.\",\"id\":\"s1_3165\",\"timestamp\":1773161414},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Do not lose yourself to it, either. Arator needs his father. I need my love.\",\"id\":\"s1_3166\",\"timestamp\":1773161422},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: You must decide if you wield the Light, or if it wields you.\",\"id\":\"s1_3167\",\"timestamp\":1773161429},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257184::::::::90:102::31:1:13634:1:28:3320:::::|h[Voidbreaker's Jacket]|h|r\",\"id\":\"s1_3168\",\"timestamp\":1773161442},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264660::::::::90:102::11::1:28:3320:::::|h[Ren'dorei Spired Tent]|h|r\",\"id\":\"s1_3169\",\"timestamp\":1773161442},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Mystic Birdhat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Mystic Birdhat says: There is nothing in all Pandaria that can stay the rampage of the Grand Expedition Yak. Pray you never see it.\",\"id\":\"s1_3170\",\"timestamp\":1773161498},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Lonelylitten-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:245755::::::::90:102::::1:40:2881:::::|h[Thalassian Treatise on Alchemy]|h|r\",\"id\":\"s1_3171\",\"timestamp\":1773161705},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx5\",\"id\":\"s1_3172\",\"timestamp\":1773161710},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx1\",\"id\":\"s1_3173\",\"timestamp\":1773161710},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Camberon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Camberon says: I'm far too busy to keep up with your training, but you're welcome to use my cauldron over there.\",\"id\":\"s1_3174\",\"timestamp\":1773161729},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Nikeshoes-Zul'jin\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Nikeshoes-Zul'jin|h[|cffff7c0aNikeshoes-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:62157:Player-61-0FD2A743:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Sadistic Shamans (Hard)]|h|r!\",\"id\":\"s1_3175\",\"timestamp\":1773161803},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Ni