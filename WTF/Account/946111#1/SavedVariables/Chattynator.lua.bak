["text"] = "|Hplayer:Vudor-EarthenRing|h[|cff3fc7ebVudor-EarthenRing|r]|h has earned the achievement |cffffff00|Hachievement:62157:Player-100-05B3CEDD:1:3:21:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Sadistic Shamans (Hard)]|h|r!",
