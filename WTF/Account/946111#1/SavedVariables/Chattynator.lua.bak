rage\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Georgious-Korgath\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Georgious-Korgath receives loot: |cnIQ0:|Hitem:260666::::::::90:105:::::::::|h[Earthy Mushroom]|h|r.\",\"id\":\"s0_4151\",\"timestamp\":1772950166},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"ROGUE\",\"name\":\"Anetta-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Anetta receives loot: |cnIQ0:|Hitem:260309::::::::90:105:::::::::|h[Thrumming Plant Matter]|h|r.\",\"id\":\"s0_4152\",\"timestamp\":1772950167},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"MONK\",\"name\":\"Cinderelly-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Cinderelly-Illidan receives loot: |cnIQ0:|Hitem:260309::::::::90:105:::::::::|h[Thrumming Plant Matter]|h|r.\",\"id\":\"s0_4153\",\"timestamp\":1772950168},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Georgious-Korgath\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Georgious-Korgath receives loot: |cnIQ0:|Hitem:260665::::::::90:105:::::::::|h[Sizable Tusk]|h|r.\",\"id\":\"s0_4154\",\"timestamp\":1772950188},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Kojapa-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Kojapa-Kel'Thuzad receives loot: |cnIQ0:|Hitem:260665::::::::90:105:::::::::|h[Sizable Tusk]|h|rx2.\",\"id\":\"s0_4155\",\"timestamp\":1772950190},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"id\":\"s0_4156\",\"timestamp\":1772950194},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Beautiful! She reminds me of Vereesa. My sister was also ferocity itself if her family was threatened.\",\"id\":\"s0_4157\",\"timestamp\":1772950275},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Kojapa-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Kojapa-Kel'Thuzad receives loot: |cnIQ4:|Hitem:251079::::::::90:105::23:6:12779:13439:6652:13534:12699:13577:1:28:3022:::::|h[Amberfrond Bracers]|h|r.\",\"id\":\"s0_4158\",\"timestamp\":1772950279},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, let's find the next relic.\",\"id\":\"s0_4159\",\"timestamp\":1772950284},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas didn't ask to be Ranger-General, but she gave everything to the task... including her life.\",\"id\":\"s0_4160\",\"timestamp\":177295