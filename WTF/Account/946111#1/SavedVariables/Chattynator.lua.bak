OT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260647::::::::90:1473:::::::::|h[Digested Human Hand]|h|r\",\"id\":\"s0_3077\",\"timestamp\":1772854972},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 22 Gold, 31 Silver, 94 Copper\",\"id\":\"s0_3078\",\"timestamp\":1772854973},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Akidelic-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Akidelic receives loot: |cnIQ1:|Hitem:242639::::::::90:1473:::::::::|h[Practically Pork]|h|rx2.\",\"id\":\"s0_3079\",\"timestamp\":1772855066},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Akidelic-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Akidelic receives loot: |cnIQ0:|Hitem:260647::::::::90:1473:::::::::|h[Digested Human Hand]|h|r.\",\"id\":\"s0_3080\",\"timestamp\":1772855067},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"id\":\"s0_3081\",\"timestamp\":1772855070},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Beautiful! She reminds me of Vereesa. My sister was also ferocity itself if her family was threatened.\",\"id\":\"s0_3082\",\"timestamp\":1772855154},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 13 Gold, 5 Silver, 86 Copper\",\"id\":\"s0_3083\",\"timestamp\":1772855160},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Ottertotem-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Ottertotem-Illidan receives loot: |cnIQ4:|Hitem:251079::::::::90:1473::23:6:12779:13439:6652:12667:12699:13577:1:28:3022:::::|h[Amberfrond Bracers]|h|r.\",\"id\":\"s0_3084\",\"timestamp\":1772855161},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, let's find the next relic.\",\"id\":\"s0_3085\",\"timestamp\":1772855163},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Cindyrdh-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Cindyrdh-Illidan:115:PARTY:|h[|cffa330c9Cindyrdh-Illidan|r]|h: that warlock damage is insane\",\"id\":\"s0_3086\",\"timestamp\":1772855176},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas didn't ask to be Ranger-General, but she gave everything to the task... including her life.\",\"id\":\"s0_3087\",\"timestamp\":1772855190},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: She trained with a bow gifted by our mother. Undead fanatics have invaded to loot it, and anything else that belonged to her.\",\"id\":\"s0_3088\",\"timestamp\":1772855231},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Ottertotem-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Ottertotem-Illidan receives loot: |cnIQ0:|Hitem:260639::::::::90:1473:::::::::|h[Fractured Bone]|h|r.\",\"id\":\"s0_3089\",\"timestamp\":1772855303},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Ottertotem-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Ottertotem-Illidan receives loot: |cnIQ0:|Hitem:260639::::::::90:1473:::::::::|h[Fractured Bone]|h|r.\",\"id\":\"s0_3090\",\"timestamp\":1772855407},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Ottertotem-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Ottertotem-Illidan receives loot: |cnIQ0:|Hitem:260660::::::::90:1473:::::::::|h[Putrid Mushroom Spores]|h|rx2.\",\"id\":\"s0_3091\",\"timestamp\":1772855407},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Cindyrdh-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Cindyrdh-Illidan receives loot: |cnIQ0:|Hitem:260660::::::::90:1473:::::::::|h[Putrid Mushroom Spores]|h|rx2.\",\"id\":\"s0_3092\",\"timestamp\":1772855412},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARLOCK\",\"name\":\"Akidelic-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Akidelic-Area52:123:PARTY:|h[|cff8788eeAkidelic|r]|h: its aug buffs\",\"id\":\"s0_3093\",\"timestamp\":1772855416},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Our mother's bow meant everything to Sylvanas, once. I'll need it.\",\"id\":\"s0_3094\",\"timestamp\":1772855419},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Barelynoer-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"b\":1,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Barelynoer-Area52:125:SAY:|h[|cff33937fBarelynoer|r]|h says: :D\",\"id\":\"s0_3095\",\"timestamp\":1772855423},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Kalis\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Kalis yells: My Queen... we... failed...\",\"id\":\"s0_3096\",\"timestamp\":1772855535},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas was sometimes vain, and loved to be admired, but she never wanted to be worshipped.\",\"id\":\"s0_3097\",\"timestamp\":1772855540},{\"recordedBy\":\"Barelynoer-Area52\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Kalis-Azshara\",\"sex\":2},\"