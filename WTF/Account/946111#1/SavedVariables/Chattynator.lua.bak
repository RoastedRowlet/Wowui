},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kul'amara the Fierce says: I fear they be sacrificed for some dark purpose. Come. I will guide you. We gonna rescue my people.",
["timestamp"] = 1774329672,
["id"] = "s7_4915",
},
