\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx10\",\"timestamp\":1773507731,\"id\":\"s2_4972\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You create: |cnIQ1:|Hitem:241304::::::::81:1480::::2:38:14:40:3252:::::|h[Silvermoon Health Potion |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|rx5.\",\"timestamp\":1773507733,\"id\":\"s2_4973\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Alchemy has increased to 3.\",\"timestamp\":1773507733,\"id\":\"s2_4974\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Dis must be de fire Lilaju spoke of.\",\"timestamp\":1773508951,\"id\":\"s2_4975\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.\",\"timestamp\":1773508954,\"id\":\"s2_4976\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.\",\"timestamp\":1773508965,\"id\":\"s2_4977\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.\",\"timestamp\":1773508976,\"id\":\"s2_4978\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.\",\"timestamp\":1773508986,\"id\":\"s2_4979\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"Worgen\",\"name\":\"Enoch-Ragnaros\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Enoch-Ragnaros receives loot: |cnIQ1:|Hitem:238511::::::::81:1480::::1:38:13:::::|h[Void-Tempered Leather |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r.\",\"timestamp\":1773508992,\"id\":\"s2_4980\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Camniss-Quel'Thalas\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Camniss-Quel'Thalas receives loot: |cnIQ1:|Hitem:242639::::::::81:1480:::::::::|h[Practically Pork]|h|rx3.\",\"timestamp\":1773509029,\"id\":\"s2_4981\"},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"Worgen\",\"name\":\"Enoch-Ragnaros\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0}