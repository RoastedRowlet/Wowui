["name"] = "Cataloger Crimsonmane",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Cataloger Crimsonmane says: Druid! You've got a look that says you know a thing or two about style!",
["timestamp"] = 1774135518,
["id"] = "s7_2760",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Decimus says: I hunger for the opportunity to work together again. Come, let us forge a weapon worthy of your allies.",
["timestamp"] = 1774135551,
["id"] = "s7_2761",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Decimus says: The beasts grow famished. Why not give them something to gnaw on?",
["timestamp"] = 1774135567,
["id"] = "s7_2762",
},
{
["recordedBy"] = "Lonelylitten-Stormrage",
["typeInfo"] = {
["player"] = {
["class"] = "DRUID",
["race"] = "NightElf",
["name"] = "Lonelylitten",
["sex"] = 2,
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["r"] = 1,
["g"] = 0.501960813999176,
["b"] = 0.250980406999588,
},
["text"] = "As you step inside, drawn ever closer to hidden treasure, your Coffer Key Shards stir as if awakened by the promise of riches. They shimmer, then fuse together, becoming whole once more.",
["timestamp"] = 1774135578,
["id"] = "s7_2763",
},
