},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Cindyrcrafts-Illidan:1699:PARTY:|h[|cff3fc7ebCindyrcrafts-Illidan|r]|h: Bayne\",\"id\":\"s3_2980\",\"timestamp\":1773520734},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"MAGE\",\"name\":\"Cindyrcrafts-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Cindyrcrafts-Illidan:1704:PARTY:|h[|cff3fc7ebCindyrcrafts-Illidan|r]|h: Bayneh\",\"id\":\"s3_2981\",\"timestamp\":1773520743},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"WARRIOR\",\"name\":\"Bäñë-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Bäñë receives loot: |cnIQ2:|Hitem:237363::::::::82:1480::::1:38:14:::::|h[Umbral Tin Ore |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|r.\",\"id\":\"s3_2982\",\"timestamp\":1773520772},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"WARRIOR\",\"name\":\"Bäñë-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Bäñë receives loot: |cnIQ3:|Hitem:236949::::::::82:1480:::::::::|h[Mote of Light]|h|rx2.\",\"id\":\"s3_2983\",\"timestamp\":1773520772},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: My sisters were the last to visit these halls, but they threw their home and their bond away. If we can calm the spirits here, maybe they'll return.\",\"id\":\"s3_2984\",\"timestamp\":1773520828},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The Ranger-General was sharp and steadfast, while the peacekeeper kept the calm. Which path will you choose?\",\"id\":\"s3_2985\",\"timestamp\":1773520838},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Vereesa was the peacekeeper of our family. She spent many days tending to the gardens here, but the wilderness has overtaken it now.\",\"id\":\"s3_2986\",\"timestamp\":1773520917},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ1:|Hitem:242639::::::::82:1480:::::::::|h[Practically Pork]|h|r.\",\"id\":\"s3_2987\",\"timestamp\":1773521017},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ0:|Hitem:260671::::::::82:1480:::::::::|h[Oversized Gland]|h|r.\",\"id\":\"s3_2988\",\"timestamp\":1773521017},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Angryabsol-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::82:1480:::::::::|h[Practically Pork]|h|r\",\"id\":\"s3_2989\",\"timestamp\":1773521017},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: The soothing sounds of my harp brought Vereesa joy beyond measure. I'll need that relic.\",\"id\":\"s3_2990\",\"timestamp\":1773521020},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"id\":\"s3_2991\",\"timestamp\":1773521076},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_TARGETICONS\",\"type\":\"TARGETICONS\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Nightmaz|h[Nightmaz]|h sets |TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_5:0|t on Bäñë.\",\"id\":\"s3_2992\",\"timestamp\":1773521080},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Beautiful! She reminds me of Vereesa. My sister was also ferocity itself if her family was threatened.\",\"id\":\"s3_2993\",\"timestamp\":1773521177},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PRIEST\",\"name\":\"Grake-Kil'jaeden\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Grake-Kil'jaeden|h[|cffffffffGrake-Kil'jaeden|r]|h has earned the achievement |cffffff00|Hachievement:61639:Player-9-0E6C66B9:1:3:14:26:4294967295:4294967295:4294967295:4294967295|h[Maisara Caverns]|h|r!\",\"id\":\"s3_2994\",\"timestamp\":1773521179},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Nightmaz-Durotan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Nightmaz-Durotan receives loot: |cnIQ3:|Hitem:250144::::::::82:1480::17:2:13441:13436:2:9:88:28:3023:::::|h[Emberwing Feather]|h|r.\",\"id\":\"s3_2995\",\"timestamp\":1773521182},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 12 Gold, 71 Silver, 6 Copper\",\"id\":\"s3_2996\",\"timestamp\":1773521184},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Come, let's find the next relic.\",\"id\":\"s3_2997\",\"timestamp\":1773521186},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: Sylvanas didn't ask to be Ranger-General, but she gave everything to the task... including her life.\",\"id\":\"s3_2998\",\"timestamp\":1773521202},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lirath Windrunner says: She trained with a bow gifted by our mother. Undead fanatics have invaded to loot it, and anything else that belonged to her.\",\"id\":\"s3_2999\",\"timestamp\":1773521233},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ0:|Hitem:260660::::::::82:1480:::::::::|h[Putrid Mushroom Spores]|h|r.\",\"id\":\"s3_3000\",\"timestamp\":1773521270},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"WARRIOR\",\"name\":\"Bäñë-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Bäñë receives loot: |cnIQ0:|Hitem:260660::::::::82:1480:::::::::|h[Putrid Mushroom Spores]|h|rx2.\",\"id\":\"s3_3001\",\"timestamp\":1773521321},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ0:|Hitem:260639::::::::82:1480:::::::::|h[Fractured Bone]|h|rx2.\",\"id\":\"s3_3002\",\"timestamp\":1773521334},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Orcanea-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Orcanea-Illidan receives loot: |cnIQ0:|Hitem:260660::::::::82:1480:::::::::|h[Putrid Mushroom Spores]|h|r.\",\"id\":\"s3_3003\",\"timestamp\":1773521334},{\"recordedBy\":\"Angryabsol-Stormrage\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Nightmaz-Durotan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Nightmaz-Durotan receives loot: |cnIQ0:|Hitem:260660::::::::82:1480:::::::::|h[Putrid Mushroom Spores]|h|r.\",\"id\":\"s3_3004\",\"timestamp\":1773521338},{\"recordedBy\":\"Angryabsol-St