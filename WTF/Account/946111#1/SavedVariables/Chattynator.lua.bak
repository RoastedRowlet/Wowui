olor\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Catalogue every newcomer. I want no secrets among these latest arrivals.\",\"timestamp\":1773181833,\"id\":\"s1_3938\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I hunger for the opportunity to work together again. Come, let us forge a weapon worthy of your allies.\",\"timestamp\":1773181844,\"id\":\"s1_3939\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"timestamp\":1773181888,\"id\":\"s1_3940\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"timestamp\":1773181894,\"id\":\"s1_3941\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"timestamp\":1773181900,\"id\":\"s1_3942\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"BloodElf\",\"name\":\"Frostyfae-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Frostyfae-Illidan receives loot: |cnIQ0:|Hitem:260654::::::::90:105:::::::::|h[Abrasive Sand]|h|r.\",\"timestamp\":1773181959,\"id\":\"s1_3943\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Corewarden Nysarra yells: What a miserable display! You have all failed in your purpose!\",\"timestamp\":1773182083,\"id\":\"s1_3944\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ0:|Hitem:260659::::::::90:105:::::::::|h[Stellar Vortex Residue]|h|rx3.\",\"timestamp\":1773182084,\"id\":\"s1_3945\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ0:|Hitem:260638::::::::90:105:::::::::|h[Fine Void Residue]|h|r.\",\"timestamp\":1773182084,\"id\":\"s1_3946\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ2:|Hitem:251923::::::::90:105:::::::::|h[Thalassian Essence of the Faire]|h|r.\",\"timestamp\":1773182084,\"id\":\"s1_3947\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Impuratus-Alleria\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Impuratus-Alleria receives loot: |cnIQ3:|Hitem:245832::::::::90:105:::::::::|h[Three of Hunt]|h|r.\",\"timestamp\":1773182085,\"id\":\"s1_3948\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Corewarden Nysarra yells: Is there no end to you intruders? Do us all a favor and die before I have to kill you myself.\",\"timestamp\":1773182115,\"id\":\"s1_3949\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Corewarden Nysarra yells: Prove your worth, you pathetic lackeys.\",\"timestamp\":1773182133,\"id\":\"s1_3950\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"BloodElf\",\"name\":\"Frostyfae-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Frostyfae-Illidan receives loot: |cnIQ0:|Hitem:260659::::::::90:105:::::::::|h[Stellar Vortex Residue]|h|r.\",\"timestamp\":1773182138,\"id\":\"s1_3951\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"name\":\"Corewarden Nysarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Corewarden Nysarra yells: Minions, do not disappoint me again.\",\"timestamp\":1773182163,\"id\":\"s1_3952\"},{\"recordedBy\":\"Lonelylitten-Stormrage\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"NightElf\",\"name\":\"Highwaym-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Highwaym receives loot: |cn