["set"] = "return function(NSI, v) for i=14, 16 do NSRT.EncounterAlerts[3420][i].MarkerMap.ShowPlayerArrow = v end NSI.EncounterAlertStop[3420](NSI) NSI.EncounterAlertStart[3420](NSI, 16, \"Marker Map\") end",
