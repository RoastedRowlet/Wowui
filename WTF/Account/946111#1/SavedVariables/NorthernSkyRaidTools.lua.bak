["WaveDirection"] = {
["extraOptions"] = {
{
["height"] = 70,
["Type"] = "Label",
["text"] = "Use /yell for left or /raid for Right during the input windows, from 6 seconds before until 6 seconds after each wave and submerge. The second wave combines the submerge and wave inputs.",
},
{
["Type"] = "Button",
["label"] = "Create Macros",
["tooltip"] = {
["title"] = "Create Macros",
["desc"] = "Creates a yell macro for Left and a raid macro for Right, or updates the existing macros.",
},
["func"] = "return function(NSI)\n                local macros = {\n                    {name = NSI:Loc(\"Ula'tek Left\"), icon = 450906, message = \"/yell \".. NSI:Loc(\"Left\")},\n                    {name = NSI:Loc(\"Ula'tek Right\"), icon = 450908, message = \"/raid \".. NSI:Loc(\"Right\")},\n                }\n                for macroIndex, macro in ipairs(macros) do\n                    if GetMacroInfo(macro.name) then\n                        EditMacro(macro.name, macro.name, macro.icon, macro.message)\n                    else\n                        CreateMacro(macro.name, macro.icon, macro.message)\n                    end\n                end\n            end",
["width"] = 180,
},
{
["min"] = 1,
["Type"] = "Slider",
["label"] = "Duration Seconds",
["max"] = 30,
["set"] = "return function(NSI, value) NSRT.EncounterAlerts[3492][16].WaveDirection.dur = value end",
