["InterruptWhisperAlert"] = {
["extraOptions"] = {
{
["text"] = "This Alert shows up whenever you receive any whisper at all during the encounter. It cannot filter out wrong whispers.",
["Type"] = "Label",
},
{
["set"] = "return function(NSI, value) NSRT.EncounterAlerts[3421][16].InterruptWhisperAlert.ShowWhisperSender = value end",
["Type"] = "Checkbox",
["get"] = "return function() return NSRT.EncounterAlerts[3421][16].InterruptWhisperAlert.ShowWhisperSender or false end",
["label"] = "Show Whisper Sender",
},
},
["group"] = "Twin Fangs",
["text"] = "Your Interrupt",
["sound"] = "|cFF4BAAC8Interrupt|r",
["difficulties"] = {
16,
},
["encID"] = 3421,
["Preview"] = "        return function(self)\n            local alert = NSRT.EncounterAlerts[3421][16].InterruptWhisperAlert\n            local info = self:CreateReminder(CopyTable(alert), true)\n            if alert.ShowWhisperSender then\n                local sender = secretwrap(UnitName(\"player\"))\n                local senderGUID = secretwrap(UnitGUID(\"player\"))\n                local classFilename = senderGUID and select(2, UnitClassFromGUID(senderGUID))\n                local classColor = classFilename and C_ClassColor.GetClassColor(classFilename)\n                local senderNameClassColored = classColor and C_ColorUtil.WrapTextInColor(sender, classColor) or sender\n                info.text = string.format(\"%s - %s\", alert.text, senderNameClassColored)\n            end\n            self:DisplayReminder(info)\n        end\n    ",
["internalID"] = "InterruptWhisperAlert",
["isSpecialDisplay"] = true,
["enabled"] = false,
["TTSTimer"] = 3,
["BlockCopy"] = true,
["timers"] = {
},
["phase"] = 1,
["pinned"] = true,
["ShowWhisperSender"] = false,
["DefaultEnabled"] = false,
["ReloeReminder"] = true,
["TTS"] = false,
["name"] = "Interrupt Whisper Alert",
["IsAlert"] = true,
["dur"] = 3,
["sticky"] = 0,
["id"] = 0.4,
["DisplayType"] = "Text",
},
