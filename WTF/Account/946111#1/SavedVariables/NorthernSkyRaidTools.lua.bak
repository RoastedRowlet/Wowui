{
["Type"] = "Checkbox",
["label"] = "Active Entire Fight",
["tooltip"] = {
["title"] = "Active Entire Fight",
["desc"] = "Keeps the marker map visible from pull until the encounter ends instead of only around configured mechanic windows.",
},
["set"] = "return function(NSI, v) for i=14, 16 do NSRT.EncounterAlerts[3420][i].MarkerMap.ActiveEntireFight = v end end",
["get"] = "return function() return NSRT.EncounterAlerts[3420][16].MarkerMap.ActiveEntireFight == true end",
},
{
["text"] = "World marker positions",
["Type"] = "Label",
},
{
["Type"] = "Dropdown",
["values"] = "return function(NSI)\n        local values = {{label = \"None\", value = 0}}\n        for markerID = 1, 8 do\n            values[#values + 1] = {\n                label = string.format(\"|TInterface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_%d:18:18|t %s\", markerID, _G[\"RAID_TARGET_\" .. markerID]),\n                value = markerID,\n            }\n        end\n        return values\n    end",
["label"] = "North",
["set"] = "return function(NSI, value)\n                value = tonumber(value)\n                if value == nil or value < 0 or value > 8 then return end\n                for difficultyID = 14, 16 do\n                    local settings = NSRT.EncounterAlerts[3420][difficultyID].MarkerMap\n                    settings.MarkerOrder = settings.MarkerOrder or {3,8,4,5,6,7,1,2}\n                    settings.MarkerOrder[1] = value\n                end\n                NSI.EncounterAlertStop[3420](NSI)\n                NSI.EncounterAlertStart[3420](NSI, 16, \"Marker Map\")\n            end",
["get"] = "return function()\n                local order = NSRT.EncounterAlerts[3420][16].MarkerMap.MarkerOrder\n                return order and order[1] or 1\n            end",
},
{
["Type"] = "Dropdown",
